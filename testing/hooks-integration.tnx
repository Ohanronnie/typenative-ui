import { Array } from "std/collections";
import { String } from "std/string";
import { Button, Text, View } from "../src/components";
import { Cleanup, Context, createContext, useCallback, useContext, useDeferredValue, useEffect, useId, useLayoutEffect, useMemo, useReducer, useRef, useState } from "../src/hooks/hooks";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element, kindButton, kindText } from "../src/tnx-runtime";

static mut layoutRuns: i32 = 0;
static mut passiveRuns: i32 = 0;
static mut cleanups: i32 = 0;
static mut latestCount: i32 = 0;
static mut latestReduced: i32 = 0;
static mut latestMemo: i32 = 0;
static mut latestRef: i32 = 0;
static mut latestTheme: i32 = 0;
static mut stableId: u64 = 0;
static mut latestId: u64 = 0;
static mut latestDeferred: i32 = 0;
static mut updateNotifications: i32 = 0;
function notifyUpdate(): void {
  unsafe {
    updateNotifications = updateNotifications + 1i32;
  }
}
function cleanup(): void {
  unsafe {
    cleanups = cleanups + 1i32;
  }
}
function layoutEffect(): Cleanup {
  unsafe {
    layoutRuns = layoutRuns + 1i32;
  }
  return cleanup;
}
function passiveEffect(): Cleanup {
  unsafe {
    passiveRuns = passiveRuns + 1i32;
  }
  return cleanup;
}
function add(current: i32, action: i32): i32 {
  return current + action;
}
function stableDependencies(): Array<u64> {
  const values = new Array<u64>({
    capacity: 1usize,
  });
  values.push(1u64);
  return move values;
}
struct CounterProps {
  public context: &Context<i32>;
}
function Counter(props: CounterProps): Element {
  const[current, setState] = useState<i32>(0i32);
  const[reduced, dispatch] = useReducer<i32, i32>(add, 0i32);
  const theme = useContext<i32>(props.context);
  const reference = useRef<i32>(0i32);
  reference.write(current);
  const referenceValue = reference.read();
  const deferred = useDeferredValue<i32>(current);
  const identifier = useId();
  const memoized = useMemo<i32, u64>(move(): i32 => current, stableDependencies());
  useLayoutEffect(layoutEffect, stableDependencies());
  useEffect(passiveEffect, stableDependencies());
  unsafe {
    latestCount = current;
    latestReduced = reduced;
    latestMemo = memoized;
    latestRef = referenceValue;
    latestTheme = theme;
    latestId = identifier;
    latestDeferred = deferred;
    if (stableId === 0u64) {
      stableId = identifier;
    }
  }
  let label: &str = "Count: 0";
  if (current !== 0i32) {
    label = "Count: 1";
  }
  const increment = move(): void => {
    setState(current + 1i32);
    dispatch(1i32);
    unsafe {
      latestReduced = reduced;
    }
  };
  const callback = useCallback(increment, stableDependencies());
  return <View>
    <Text>
      {
        String(label)}
      </Text>
      <Button onPress={callback}>Increment</Button>
    </View>;
  }
  function main(): i32 {
    using renderer = new HeadlessRenderer();
    const context = createContext<i32>(7i32);
    renderer.mount(<Counter context={ &context} />);
    if (!renderer.hasKind(kindButton()) || renderer.textLengthFirst(kindButton()) !== 9usize) {
      renderer.unmount();
      return 10;
    }
    renderer.focusFirst(kindButton());
    if (!renderer.isFocusedFirst(kindButton())) {
      renderer.unmount();
      return 11;
    }
    renderer.setUpdateCallback(notifyUpdate);
    renderer.simulatePressFirst(kindButton());
    renderer.update(<Counter context={ &context} />);
    const validText = renderer.textLengthFirst(kindText()) === 8usize;
    let validHooks = false;
    unsafe {
      validHooks = validText && latestCount === 1i32 && latestReduced === 1i32 && latestMemo === 0i32 && latestRef === 1i32 && latestDeferred === 1i32 && latestTheme === 7i32 && stableId === latestId && layoutRuns === 1i32 && passiveRuns === 1i32 && updateNotifications === 1i32;
    }
    if (!validHooks) {
      renderer.unmount();
      return 12;
    }
    context.provide(9i32);
    renderer.update(<Counter context={ &context} />);
    unsafe {
      if (latestTheme !== 9i32) {
        renderer.unmount();
        return 14;
      }
    }
    renderer.unmount();
    let validCleanup = false;
    unsafe {
      validCleanup = cleanups === 2i32;
    }
    if (!validCleanup) {
      return 15;
    }
    return 0;
  }
