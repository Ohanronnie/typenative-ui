import { String } from "std/string";
import { Button } from "../src/components";
import { HeadlessRenderer } from "../src/renderer/headless";
import { ElementRef, createElementRef, kindButton } from "../src/tnx-runtime";

function hit(): void {
}
function main(): i32 {
  let reference = createElementRef();
  using renderer = new HeadlessRenderer();
  let element = Button({
    children: String("Ref"), onPress: hit,
  });
  element.bindReference( &reference);
  renderer.mount(move element);
  if (!reference.isAttached()) {
    renderer.unmount();
    return 10;
  }
  const mounted = renderer.rootElement();
  if (mounted.kind() !== kindButton() || mounted.textLength() !== 3usize || reference.nodeIdentity() === undefined) {
    renderer.unmount();
    return 11;
  }
  renderer.unmount();
  if (reference.isAttached()) {
    return 12;
  }
  return 0;
}
