import { Array } from "std/collections";
import { Priority, Scheduler, UiScheduler } from "../src/scheduler/scheduler";

static mut order: i32 = 0;
static mut runs: i32 = 0;
static mut bulkRuns: usize = 0;
static mut highRuns: i32 = 0;
static mut normalRuns: i32 = 0;
function mark(value: i32): void {
  unsafe {
    order = order * 10i32 + value;
    runs = runs + 1i32;
  }
}
function noWork(): void {
}
function countWork(): void {
  unsafe {
    bulkRuns = bulkRuns + 1usize;
  }
}
function markHigh(): void {
  unsafe {
    highRuns = highRuns + 1i32;
  }
}
function markNormal(): void {
  unsafe {
    normalRuns = normalRuns + 1i32;
  }
}
function executeMany(scheduler: &mut Scheduler): bool {
  let index: usize = 0;
  while (index<100000usize) {
    scheduler.schedule(countWork);
    index = index + 1usize;
  }
  if (scheduler.pendingCount() !== 100000usize) {
    return false;
  }
  if (scheduler.flush(100000usize) !== 100000usize || scheduler.pendingCount() !== 0usize) {
    return false;
  }
  unsafe {
    return bulkRuns === 100000usize;
  }
}
function cancelMany(scheduler: &mut Scheduler): bool {
  const jobs = new Array<u64>({
    capacity: 100000usize,
  });
  let index: usize = 0;
  while (index<100000usize) {
    const sequence: u64 = scheduler.schedule(noWork);
    jobs.push(sequence);
    index = index + 1usize;
  }
  if (scheduler.pendingCount() !== 100000usize) {
    return false;
  }
  index = 0usize;
  while (index<jobs.length) {
    const sequence = jobs.at(index);
    if (sequence === undefined) {
      return false;
    }
    unsafe {
      if (!scheduler.cancel( * sequence!)) {
        return false;
      }
    }
    index = index + 1usize;
  }
  return scheduler.pendingCount() === 0usize && scheduler.flush(1usize) === 0usize;
}
function main(): i32 {
  using scheduler = new Scheduler();
  const cancelled = scheduler.schedule(move(): void => {
    mark(9i32);
  });
  if (!scheduler.cancel(cancelled)) {
    return 10;
  }
  scheduler.scheduleWithPriority(Priority.Low, move(): void => {
    mark(3i32);
  });
  scheduler.scheduleWithPriority(Priority.Immediate, move(): void => {
    mark(1i32);
  });
  scheduler.scheduleWithPriority(Priority.Normal, move(): void => {
    mark(2i32);
  });
  if (scheduler.flush(2usize) !== 2usize || !scheduler.hasWork()) {
    return 11;
  }
  if (scheduler.flush(8usize) !== 1usize || scheduler.hasWork()) {
    return 12;
  }
  unsafe {
    if (order !== 123i32 || runs !== 3i32) {
      return 13;
    }
  }
  if (!executeMany( &mut scheduler)) {
    return 19;
  }
  if (!cancelMany( &mut scheduler)) {
    return 18;
  }
  using fairness = new Scheduler();
  fairness.schedule(markNormal);
  let highIndex: usize = 0;
  while (highIndex<16usize) {
    fairness.scheduleWithPriority(Priority.Immediate, markHigh);
    highIndex = highIndex + 1usize;
  }
  if (fairness.flushFor(0u64) !== 0usize) {
    return 20;
  }
  if (fairness.flush(9usize) !== 9usize) {
    return 21;
  }
  unsafe {
    if (highRuns !== 8i32 || normalRuns !== 1i32) {
      return 22;
    }
  }
  if (fairness.flush(32usize) !== 8usize) {
    return 23;
  }
  unsafe {
    if (highRuns !== 16i32 || normalRuns !== 1i32) {
      return 24;
    }
  }
  unsafe {
    order = 0i32;
    runs = 0i32;
  }
  using ui = new UiScheduler();
  const normal = ui.post(Priority.Normal, move(): void => {
    mark(2i32);
  });
  if (normal === undefined) {
    return 14;
  }
  const immediate = ui.post(Priority.Immediate, move(): void => {
    mark(1i32);
  });
  if (immediate === undefined) {
    return 15;
  }
  if (ui.drain(4usize) !== 2usize) {
    return 16;
  }
  unsafe {
    if (order !== 12i32 || runs !== 2i32) {
      return 17;
    }
  }
  using zeroBudget = new UiScheduler();
  const zeroJob = zeroBudget.post(Priority.Normal, noWork);
  if (zeroJob === undefined || zeroBudget.drainFor(0u64) !== 0usize || zeroBudget.pendingCount() !== 1usize) {
    return 25;
  }
  if (zeroBudget.drain(1usize) !== 1usize || zeroBudget.pendingCount() !== 0usize) {
    return 26;
  }
  return 0;
}
