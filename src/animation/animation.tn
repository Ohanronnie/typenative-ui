import { u64ToUsize, usizeToF32 } from "std/alloc";
import { Array } from "std/collections";

export enum Easing {
  Linear, EaseIn, EaseOut, EaseInOut,
}
export class Animation {
  private startValue: f64;
  private endValue: f64;
  private duration: f64;
  private elapsed: f64;
  private current: f64;
  private easing: Easing;
  private running: bool;
  private update?: (f64) => void;
  public constructor(startValue: f64, endValue: f64, duration: f64, easing: Easing) {
    this.startValue = startValue;
    this.endValue = endValue;
    this.duration = duration;
    this.elapsed = 0.0;
    this.current = startValue;
    this.easing = easing;
    this.running = false;
    this.update = undefined;
  }
  public start(): void {
    this.elapsed = 0.0;
    this.current = this.startValue;
    this.running = true;
  }
  public stop(): void {
    this.running = false;
  }
  public setUpdate(callback: (f64) => void): void {
    this.update = move callback;
  }
  public clearUpdate(): void {
    this.update = undefined;
  }
  public tick(delta: f64): bool {
    if (!this.running) {
      return false;
    }
    this.elapsed = this.elapsed + delta;
    let progress = 1.0;
    if (this.duration > 0.0 && this.elapsed<this.duration) {
      progress = this.elapsed / this.duration;
    }
    if (progress >= 1.0) {
      progress = 1.0;
      this.running = false;
    }
    const eased = ease(progress, this.easing);
    this.current = this.startValue +(this.endValue - this.startValue) * eased;
    if (this.update !== undefined) {
      this.update!(this.current);
    }
    return true;
  }
  public value(): f64 {
    return this.current;
  }
  public isRunning(): bool {
    return this.running;
  }
}
export class Animator {
  private animations: Array<Animation>;
  private lastTimestampNanoseconds: u64;
  public constructor() {
    this.animations = new Array<Animation>({
      capacity: 0
    });
    this.lastTimestampNanoseconds = 0u64;
  }
  public add(animation: Animation): void {
    this.animations.push(move animation);
  }
  public tick(delta: f64): usize {
    let changed: usize = 0;
    let processed: usize = 0;
    const total = this.animations.length;
    while (processed<total) {
      const animation = this.animations.pop();
      if (animation !== undefined) {
        if (animation!.tick(delta)) {
          changed = changed + 1usize;
        }
        if (animation!.isRunning()) {
          this.animations.push(move animation!);
        }
      }
      processed = processed + 1usize;
    }
    return changed;
  }
  public count(): usize {
    return this.animations.length;
  }
  public hasRunning(): bool {
    let found = false;
    let processed: usize = 0;
    const total = this.animations.length;
    while (processed<total) {
      const animation = this.animations.pop();
      if (animation !== undefined) {
        if (animation!.isRunning()) {
          found = true;
        }
        this.animations.push(move animation!);
      }
      processed = processed + 1usize;
    }
    return found;
  }
  public clear(): void {
    while (this.animations.length > 0usize) {
      const animation = this.animations.pop();
      if (animation !== undefined) {
        animation!.stop();
        animation!.clearUpdate();
      }
    }
    this.resetClock();
  }
  public resetClock(): void {
    this.lastTimestampNanoseconds = 0u64;
  }
  public advance(timestampNanoseconds: u64): bool {
    let deltaNanoseconds = 0u64;
    if (this.lastTimestampNanoseconds !== 0u64 && timestampNanoseconds >= this.lastTimestampNanoseconds) {
      deltaNanoseconds = timestampNanoseconds - this.lastTimestampNanoseconds;
    }
    this.lastTimestampNanoseconds = timestampNanoseconds;
    const deltaSeconds = usizeToF32(u64ToUsize(deltaNanoseconds))as f64 / 1000000000.0;
    this.tick(deltaSeconds);
    return this.hasRunning();
  }
}
function ease(progress: f64, easing: Easing): f64 {
  return switch(easing) {
    case Easing.Linear: progress, case Easing.EaseIn: progress * progress, case Easing.EaseOut: 1.0 -(1.0 - progress) *(1.0 - progress), case Easing.EaseInOut: easeInOut(progress),
  };
}
function easeInOut(progress: f64): f64 {
  if (progress<0.5) {
    return 2.0 * progress * progress;
  }
  return 1.0 -(( - 2.0 * progress + 2.0) *( - 2.0 * progress + 2.0)) / 2.0;
}
