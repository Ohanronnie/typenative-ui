export struct TextSpan {
  private pointer: *const u8;
  private length: usize;
  public static fromStr(value: &str): TextSpan {
    unsafe {
      return {
        pointer: value as *const u8, length: value.byteLength,
      };
    }
  }
  public asStr(): &str {
    unsafe {
      return & *(this.pointer as *const str);
    }
  }
}
