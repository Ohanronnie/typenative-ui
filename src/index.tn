import { Array } from "std/collections";
import { Equal } from "std/core";
import { AccessibilityNode as RuntimeAccessibilityNode, AccessibilityTree as RuntimeAccessibilityTree, accessibilityNode as runtimeAccessibilityNode } from "./accessibility/accessibility";
import { Animation as RuntimeAnimation, Animator as RuntimeAnimator, Easing as RuntimeEasing } from "./animation/animation";
import { Button as NativeButton, Canvas as NativeCanvas, Dialog as NativeDialog, Grid as NativeGrid, Image as NativeImage, List as NativeList, Menu as NativeMenu, Progress as NativeProgress, ScrollView as NativeScrollView, Slider as NativeSlider, SplitView as NativeSplitView, Stack as NativeStack, Switch as NativeSwitch, Text as NativeText, TextInput as NativeTextInput, Toolbar as NativeToolbar, View as NativeView, Window as NativeWindowComponent } from "./components";
import { AccessibilityRole as CoreAccessibilityRole, Align as CoreAlign, auto as coreAuto, ButtonProps as CoreButtonProps, CanvasProps as CoreCanvasProps, DialogProps as CoreDialogProps, Display as CoreDisplay, FlexDirection as CoreFlexDirection, GridProps as CoreGridProps, ImageProps as CoreImageProps, Justify as CoreJustify, KeyboardType as CoreKeyboardType, Length as CoreLength, ListProps as CoreListProps, MenuProps as CoreMenuProps, Overflow as CoreOverflow, percent as corePercent, points as corePoints, PositionType as CorePositionType, ProgressProps as CoreProgressProps, ScrollViewProps as CoreScrollViewProps, SliderProps as CoreSliderProps, SplitViewProps as CoreSplitViewProps, StackProps as CoreStackProps, Style as CoreStyle, SwitchProps as CoreSwitchProps, TextInputProps as CoreTextInputProps, TextProps as CoreTextProps, TextSelection as CoreTextSelection, ToolbarProps as CoreToolbarProps, ViewProps as CoreViewProps, WindowClosePolicy as CoreWindowClosePolicy, WindowProps as CoreWindowProps } from "./core/types";
import { batch as hookBatch, Context as HookContext, Cleanup, flushLayoutEffectsFor, flushPassiveEffectsFor, HookOrderDiagnostic as RuntimeHookOrderDiagnostic, HookRoot, setUpdateCallbackFor, useCallback as hookUseCallback, useContext as hookUseContext, useDeferredValue as hookUseDeferredValue, useEffect as hookUseEffect, useId as hookUseId, useLayoutEffect as hookUseLayoutEffect, useMemo as hookUseMemo, useReducer as hookUseReducer, useRef as hookUseRef, useState as hookUseState, useSyncExternalStore as hookUseSyncExternalStore, useTransition as hookUseTransition, StatePair as HookStatePair, ReducerPair as HookReducerPair, Ref as HookRef, Transition as HookTransition } from "./hooks/hooks";
import { NativeRenderer as RuntimeNativeRenderer, createNativeRenderer as runtimeCreateNativeRenderer, runApp as runtimeRunApp } from "./platform/macos";
import { DuplicateKeyDiagnostic as RuntimeDuplicateKeyDiagnostic, Reconciler as RuntimeReconciler } from "./reconciler/reconciler";
import { HeadlessRenderer as RuntimeHeadlessRenderer } from "./renderer/headless";
import { Scheduler as RuntimeScheduler, UiScheduler as RuntimeUiScheduler } from "./scheduler/scheduler";
import { Element as RuntimeElement, ElementChild as RuntimeElementChild, ElementRef as RuntimeElementRef, Key as RuntimeKey, createElementRef as runtimeCreateElementRef } from "./tnx-runtime";

export type State<T > = HookStatePair<T>;
export type ReducerState<StateValue, Action > = HookReducerPair<StateValue, Action>;
export type Ref<T > = HookRef<T>;
export type EffectCleanup = Cleanup;
export type Element = RuntimeElement;
export type ElementChild = RuntimeElementChild;
export type ElementRef = RuntimeElementRef;
export function createElementRef(): ElementRef {
  return runtimeCreateElementRef();
}
export type Key = RuntimeKey;
export type Style = CoreStyle;
export type Length = CoreLength;
export type FlexDirection = CoreFlexDirection;
export type Align = CoreAlign;
export type Display = CoreDisplay;
export type PositionType = CorePositionType;
export type Justify = CoreJustify;
export type Overflow = CoreOverflow;
export type AccessibilityRole = CoreAccessibilityRole;
export type AccessibilityNode = RuntimeAccessibilityNode;
export type AccessibilityTree = RuntimeAccessibilityTree;
export type Animation = RuntimeAnimation;
export type Animator = RuntimeAnimator;
export type Easing = RuntimeEasing;
export type KeyboardType = CoreKeyboardType;
export type TextSelection = CoreTextSelection;
export type WindowClosePolicy = CoreWindowClosePolicy;
export function auto(): Length {
  return coreAuto();
}
export function points(value: f32): Length {
  return corePoints(value);
}
export function percent(value: f32): Length {
  return corePercent(value);
}
export function accessibilityNode(role: AccessibilityRole, label: &str): AccessibilityNode {
  return runtimeAccessibilityNode(role, label);
}
export type ButtonProps = CoreButtonProps;
export type TextProps = CoreTextProps;
export type TextInputProps = CoreTextInputProps;
export type ViewProps = CoreViewProps;
export type WindowProps = CoreWindowProps;
export type ImageProps = CoreImageProps;
export type ScrollViewProps = CoreScrollViewProps;
export type ListProps = CoreListProps;
export type SwitchProps = CoreSwitchProps;
export type SliderProps = CoreSliderProps;
export type ProgressProps = CoreProgressProps;
export type MenuProps = CoreMenuProps;
export type DialogProps = CoreDialogProps;
export type ToolbarProps = CoreToolbarProps;
export type SplitViewProps = CoreSplitViewProps;
export type StackProps = CoreStackProps;
export type GridProps = CoreGridProps;
export type CanvasProps = CoreCanvasProps;
export type ComponentType<Props > =(Props) => Element;
export type HostComponent<Props > =(Props) => Element;
export type Context<T > = HookContext<T>;
export type Reconciler = RuntimeReconciler;
export type DuplicateKeyDiagnostic = RuntimeDuplicateKeyDiagnostic;
export type HookOrderDiagnostic = RuntimeHookOrderDiagnostic;
export type HeadlessRenderer = RuntimeHeadlessRenderer;
export type NativeRenderer = RuntimeNativeRenderer;
export type Scheduler = RuntimeScheduler;
export type UiScheduler = RuntimeUiScheduler;
export type Transition = HookTransition;
export function Button(props: ButtonProps): Element {
  return NativeButton(move props);
}
export function Text(props: TextProps): Element {
  return NativeText(move props);
}
export function TextInput(props: TextInputProps): Element {
  return NativeTextInput(move props);
}
export function View(props: ViewProps): Element {
  return NativeView(move props);
}
export function Window(props: WindowProps): Element {
  return NativeWindowComponent(move props);
}
export function Image(props: ImageProps): Element {
  return NativeImage(move props);
}
export function ScrollView(props: ScrollViewProps): Element {
  return NativeScrollView(move props);
}
export function List(props: ListProps): Element {
  return NativeList(move props);
}
export function Switch(props: SwitchProps): Element {
  return NativeSwitch(move props);
}
export function Slider(props: SliderProps): Element {
  return NativeSlider(move props);
}
export function Progress(props: ProgressProps): Element {
  return NativeProgress(move props);
}
export function Menu(props: MenuProps): Element {
  return NativeMenu(move props);
}
export function Dialog(props: DialogProps): Element {
  return NativeDialog(move props);
}
export function Toolbar(props: ToolbarProps): Element {
  return NativeToolbar(move props);
}
export function SplitView(props: SplitViewProps): Element {
  return NativeSplitView(move props);
}
export function Stack(props: StackProps): Element {
  return NativeStack(move props);
}
export function Grid(props: GridProps): Element {
  return NativeGrid(move props);
}
export function Canvas(props: CanvasProps): Element {
  return NativeCanvas(move props);
}
export function useState<T>(initial: T): State<T> {
  return hookUseState<T>(move initial);
}
export function useReducer<StateValue, Action>(reducer: (StateValue, Action) => StateValue, initial: StateValue): ReducerState<StateValue, Action> {
  return hookUseReducer<StateValue, Action>(reducer, move initial);
}
export function useEffect<T extends Equal<T> >(effect: () => Cleanup, dependencies: Array<T >): void {
  hookUseEffect<T>(move effect, move dependencies);
}
export function useLayoutEffect<T extends Equal<T> >(effect: () => Cleanup, dependencies: Array<T >): void {
  hookUseLayoutEffect<T>(move effect, move dependencies);
}
export function useMemo<T, Dependency extends Equal<Dependency> >(factory: () => T, dependencies: Array<Dependency >): T {
  return hookUseMemo<T, Dependency>(move factory, move dependencies);
}
export function useCallback<T, Dependency extends Equal<Dependency> >(callback: T, dependencies: Array<Dependency >): T {
  return hookUseCallback<T, Dependency>(move callback, move dependencies);
}
export function useRef<T>(initial: T): Ref<T> {
  return hookUseRef<T>(move initial);
}
export function createContext<T>(initial: T): Context<T> {
  return new HookContext<T>(move initial);
}
export function useContext<T>(context: &Context<T >): T {
  return hookUseContext<T>(context);
}
export function useId(): u64 {
  return hookUseId();
}
export function useTransition(): Transition {
  return hookUseTransition();
}
export function useDeferredValue<T>(value: T): T {
  return hookUseDeferredValue<T>(move value);
}
export function useSyncExternalStore<T>(subscribe: (() => void) => Cleanup, getSnapshot: () => T): T {
  return hookUseSyncExternalStore<T>(move subscribe, move getSnapshot);
}
export function batch(callback: () => void): void {
  hookBatch(move callback);
}
export function createHeadlessRenderer(): RuntimeHeadlessRenderer {
  return new RuntimeHeadlessRenderer();
}
export function createNativeRenderer(): RuntimeNativeRenderer {
  return runtimeCreateNativeRenderer();
}
export function runApp(factory: () => Element): i32 {
  return runtimeRunApp(move factory);
}
export function mountHeadless(renderer: RuntimeHeadlessRenderer, root: Element): void {
  renderer.mount(move root);
}
export function updateHeadless(renderer: RuntimeHeadlessRenderer, root: Element): void {
  renderer.update(move root);
}
export function createReconciler(): RuntimeReconciler {
  return new RuntimeReconciler();
}
export function clearHookRoot(root: &mut HookRoot): void {
  root.clear();
}
export function setHookRootUpdateCallback(root: &mut HookRoot, callback: () => void): void {
  setUpdateCallbackFor(root, move callback);
}
export function createScheduler(): RuntimeScheduler {
  return new RuntimeScheduler();
}
export function createUiScheduler(): RuntimeUiScheduler {
  return new RuntimeUiScheduler();
}
export function flush(root: &mut HookRoot): void {
  flushLayoutEffectsFor(root);
  flushPassiveEffectsFor(root);
  root.clear();
}
