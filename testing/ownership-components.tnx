import { Text, View } from "../src/components";
import { EmptyProps } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element, hostChildAt, kindText } from "../src/tnx-runtime";

function Root(props: EmptyProps): Element {
  return <View>
    <Text>Go</Text>
  </View>;
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  const root = renderer.rootElement();
  const child = hostChildAt(root, 0usize);
  let valid = false;
  if (child !== undefined) {
    valid = child!.kind() === kindText() && child!.textLength() === 2usize;
  }
  renderer.unmount();
  if (valid) {
    return 0;
  }
  return 1;
}
