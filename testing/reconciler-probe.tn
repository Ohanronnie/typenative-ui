import { Array } from "std/collections";
import { String } from "std/string";
import { mutationCreate, mutationMove, mutationUpdate } from "../src/reconciler/mutations";
import { HeadlessRenderer } from "../src/renderer/headless";
import { createHost, createFragmentElements, hostChildAt, keyInteger, kindText, textTypeId, Element } from "../src/tnx-runtime";

function emptyChildren(): Array<Element> {
  return new Array<Element>({
    capacity: 0usize,
  });
}
function keyedText(key: u64, value: &str): Element {
  return createHost(kindText(), textTypeId(), keyInteger(key), String(value), emptyChildren());
}
function keyedTree(reversed: bool, changed: bool): Element {
  const children = new Array<Element>({
    capacity: 3usize,
  });
  if (reversed) {
    children.push(keyedText(3u64, "three"));
    children.push(keyedText(2u64, "two"));
    children.push(keyedText(1u64, changed?"one!": "one"));
  } else {
    children.push(keyedText(1u64, "one"));
    children.push(keyedText(2u64, "two"));
    children.push(keyedText(3u64, "three"));
  }
  return createFragmentElements(move children);
}
function duplicateKeyTree(): Element {
  const children = new Array<Element>({
    capacity: 3usize,
  });
  children.push(keyedText(7u64, "first"));
  children.push(keyedText(7u64, "duplicate"));
  children.push(keyedText(9u64, "unique"));
  return createFragmentElements(move children);
}
function main(): i32 {
  let result = 0i32;
  {
    using renderer = new HeadlessRenderer();
    renderer.mount(keyedTree(false, false));
    if (renderer.mutationCount() !== 4usize || renderer.lastMutationKind() !== mutationCreate()) {
      result = 11i32;
    }
    if (result === 0i32) {
      renderer.update(keyedTree(false, false));
      if (renderer.mutationCount() !== 0usize) {
        result = 12i32;
      }
    }
    if (result === 0i32) {
      renderer.update(keyedTree(true, false));
      if (renderer.mutationCount() !== 2usize || renderer.lastMutationKind() !== mutationMove()) {
        result = 13i32;
      }
    }
    if (result === 0i32) {
      renderer.update(keyedTree(true, true));
      if (renderer.mutationCount() !== 1usize || renderer.lastMutationKind() !== mutationUpdate()) {
        result = 14i32;
      }
    }
    if (result === 0i32) {
      const root = renderer.rootElement();
      const first = hostChildAt(root, 0usize);
      if (first === undefined || first!.textLength() !== 5usize) {
        result = 15i32;
      }
    }
    if (result === 0i32) {
      renderer.update(duplicateKeyTree());
      if (renderer.duplicateKeyCount() !== 1usize || !renderer.hasDiagnostics()) {
        result = 16i32;
      }
    }
    if (result === 0i32) {
      const diagnostic = renderer.duplicateKeyAt(0usize);
      if (diagnostic === undefined || diagnostic!.parentIdentity === 0u64 || diagnostic!.key.kind !== 2i32 || diagnostic!.key.integer !== 7u64 || diagnostic!.firstIndex !== 0usize || diagnostic!.duplicateIndex !== 1usize) {
        result = 17i32;
      }
    }
    if (result === 0i32) {
      renderer.update(keyedTree(false, false));
      if (renderer.duplicateKeyCount() !== 0usize || renderer.hasDiagnostics()) {
        result = 18i32;
      }
    }
    renderer.unmount();
  }
  return result;
}
