import { String } from "std/string";
import { Button } from "../src/components";
import { EmptyProps } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { dispatchPress, Element } from "../src/tnx-runtime";

static mut presses: i32 = 0;
function hit(): void {
  unsafe {
    presses = presses + 1i32;
  }
}
function Root(props: EmptyProps): Element {
  return <Button onPress={hit}>Go</Button>;
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Button onPress={hit}>Go</Button>);
  const root = renderer.rootElement();
  dispatchPress(root);
  const valid = root.textLength() === 2usize;
  renderer.unmount();
  unsafe {
    if (valid && presses === 1i32) {
      return 0;
    }
  }
  return 1;
}
