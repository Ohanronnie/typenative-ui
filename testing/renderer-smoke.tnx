import { Text } from "../src/components";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element } from "../src/tnx-runtime";

struct Props {
}
function Root(props: Props): Element {
  return <Text>Hello</Text>;
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  if (!renderer.hasKind(3i32)) {
    return 1;
  }
  renderer.unmount();
  return 0;
}
