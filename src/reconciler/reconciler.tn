  }
  public duplicateKeyAt(index: usize): DuplicateKeyDiagnostic | undefined {
    const diagnostic = this.duplicateKeyErrors.at(index);
    if (diagnostic === undefined) {
      return undefined;
    }
    return {
      parentIdentity: diagnostic!.parentIdentity, key: {
        kind: diagnostic!.key.kind, text: diagnostic!.key.text.clone(), integer: diagnostic!.key.integer, identity: diagnostic!.key.identity,
      }, firstIndex: diagnostic!.firstIndex, duplicateIndex: diagnostic!.duplicateIndex,
    };
  }
  public hasDiagnostics(): bool {
    return this.duplicateKeyErrors.length !== 0usize || this.hooks.hookOrderErrorCount() !== 0usize;
  }
  public beginBatch(): void {
    beginBatchFor( &mut this.hooks);
  }
  public endBatch(): void {
    endBatchFor( &mut this.hooks);
  }
  public setUpdateCallback(callback: () => void): void {
    setUpdateCallbackFor( &mut this.hooks, move callback);
  }
  public clearUpdateCallback(): void {
    clearUpdateCallbackFor( &mut this.hooks);
  }
}
