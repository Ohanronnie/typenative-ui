import { Array } from "std/collections";
import { Priority, Scheduler, UiScheduler } from "../src/scheduler/scheduler";

static mut order: i32 = 0;
static mut runs: i32 = 0;
function mark(value: i32): void {
  unsafe {
    order = order * 10i32 + value;
    runs = runs + 1i32;
  }
}
function noWork(): void {
}
function cancelMany(scheduler: &mut Scheduler): bool {
  const jobs = new Array<u64>({
    capacity: 100000usize,
  });
  let index: usize = 0;
  while (index<100000usize) {
    const sequence: u64 = scheduler.schedule(noWork);
    jobs.push(sequence);
    index = index + 1usize;
  }
  if (scheduler.pendingCount() !== 100000usize) {
    return false;
  }
  index = 0usize;
  while (index<jobs.length) {
    const sequence = jobs.at(index);
    if (sequence === undefined) {
      return false;
    }
    unsafe {
      if (!scheduler.cancel( * sequence!)) {
        return false;
      }
    }
    index = index + 1usize;
  }
  return scheduler.pendingCount() === 0usize && scheduler.flush(1usize) === 0usize;
}
function main(): i32 {
  using scheduler = new Scheduler();
  const cancelled = scheduler.schedule(move(): void => {
    mark(9i32);
  });
  if (!scheduler.cancel(cancelled)) {
    return 10;
  }
  scheduler.scheduleWithPriority(Priority.Low, move(): void => {
    mark(3i32);
  });
  scheduler.scheduleWithPriority(Priority.Immediate, move(): void => {
    mark(1i32);
  });
  scheduler.scheduleWithPriority(Priority.Normal, move(): void => {
    mark(2i32);
  });
  if (scheduler.flush(2usize) !== 2usize || !scheduler.hasWork()) {
    return 11;
  }
  if (scheduler.flush(8usize) !== 1usize || scheduler.hasWork()) {
    return 12;
  }
  unsafe {
    if (order !== 123i32 || runs !== 3i32) {
      return 13;
    }
  }
  if (!cancelMany( &mut scheduler)) {
    return 18;
  }
  unsafe {
    order = 0i32;
    runs = 0i32;
  }
  using ui = new UiScheduler();
  const normal = ui.post(Priority.Normal, move(): void => {
    mark(2i32);
  });
  if (normal === undefined) {
    return 14;
  }
  const immediate = ui.post(Priority.Immediate, move(): void => {
    mark(1i32);
  });
  if (immediate === undefined) {
    return 15;
  }
  if (ui.drain(4usize) !== 2usize) {
    return 16;
  }
  unsafe {
    if (order !== 12i32 || runs !== 2i32) {
      return 17;
    }
  }
  return 0;
}
