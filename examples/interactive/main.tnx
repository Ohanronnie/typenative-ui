import { log } from "std/console";
import { String } from "std/string";
import { Button, Element, HeadlessRenderer, Text, View, Window, useState } from "../../src/index";
import { kindButton, kindText } from "../../src/tnx-runtime";

struct DemoProps {
}
function Demo(props: DemoProps): Element {
  const[current, setCount] = useState<i32>(0i32);
  const increment = move(): void => {
    setCount(current + 1i32);
  };
  let label: &str = "Count: 0";
  if (current !== 0i32) {
    label = "Count: 1";
  }
  return <Window title="TypeNative UI Demo">
    <View>
      <Text>
        {
          String(label)}
        </Text>
        <Text>TypeNative UI</Text>
        <Button onPress={increment}>Increment</Button>
      </View>
    </Window>;
  }
  function main(): i32 {
    using renderer = new HeadlessRenderer();
    renderer.mount(<Demo />);
    if (!renderer.hasKind(kindButton())) {
      log("missing button");
      return 10;
    }
    renderer.simulatePressFirst(kindButton());
    renderer.update(<Demo />);
    if (renderer.textLengthFirst(kindText()) !== 8usize) {
      log("state update did not change the label");
      return 11;
    }
    renderer.unmount();
    return 0;
  }
