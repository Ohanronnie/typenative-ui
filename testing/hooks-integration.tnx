import { String } from "std/string";
import { Button, Text, View } from "../src/components";
import { clearHooks, Cleanup, Context, createContext, setUpdateCallback, useCallback, useContext, useEffect, useId, useIntReducer, useLayoutEffect, useMemo, useRef, useState } from "../src/hooks/hooks";
import { Element, hostChildAt, hostChildCount, kindButton, kindText } from "../src/jsx-runtime";
import { HeadlessRenderer } from "../src/renderer/headless";

static mut layoutRuns: i32 = 0;
static mut passiveRuns: i32 = 0;
static mut cleanups: i32 = 0;
static mut latestCount: i32 = 0;
static mut latestReduced: i32 = 0;
static mut latestMemo: i32 = 0;
static mut latestRef: i32 = 0;
static mut latestTheme: i32 = 0;
static mut stableId: u64 = 0;
static mut latestId: u64 = 0;
static mut updateNotifications: i32 = 0;
function notifyUpdate(): void {
  unsafe {
    updateNotifications = updateNotifications + 1i32;
  }
}
function cleanup(): void {
  unsafe {
    cleanups = cleanups + 1i32;
  }
}
function layoutEffect(): Cleanup {
  unsafe {
    layoutRuns = layoutRuns + 1i32;
  }
  return cleanup;
}
function passiveEffect(): Cleanup {
  unsafe {
    passiveRuns = passiveRuns + 1i32;
  }
  return cleanup;
}
function add(current: i32, action: i32): i32 {
  return current + action;
}
struct CounterProps {
  public context: &Context<i32>;
}
function Counter(props: CounterProps): Element {
  const state = useState<i32>(0i32);
  const reduced = useIntReducer(add, 0i32);
  const current = state.current();
  const theme = useContext<i32>(props.context);
  const reference = useRef<i32>(0i32);
  reference.write(current);
  const referenceValue = reference.read();
  const identifier = useId();
  const increment = move(): void => {
    state.set(state.current() + 1i32);
    reduced.dispatch(add, 1i32);
  };
  const callback = useCallback(increment, 1u64);
  const memoized = useMemo<i32>(move(): i32 => current, 1u64);
  useLayoutEffect(layoutEffect, 1u64);
  useEffect(passiveEffect, 1u64);
  unsafe {
    latestCount = current;
    latestReduced = reduced.current();
    latestMemo = memoized;
    latestRef = referenceValue;
    latestTheme = theme;
    latestId = identifier;
    if (stableId === 0u64) {
      stableId = identifier;
    }
  }
  let label: &str = "Count: 0";
  if (current !== 0i32) {
    label = "Count: 1";
  }
  return <View>
    <Text>
      {
        String(label)}
      </Text>
      <Button onPress={callback}>Increment</Button>
    </View>;
  }
  function findFirst(element: Element, kind: i32): Element | undefined {
    if (element.kind() === kind) {
      return element;
    }
    let index: usize = 0;
    while (index<hostChildCount(element)) {
      const child = hostChildAt(element, index);
      if (child !== undefined) {
        const found = findFirst(child!, kind);
        if (found !== undefined) {
          return found;
        }
      }
      index = index + 1usize;
    }
    return undefined;
  }
  function main(): i32 {
    using renderer = new HeadlessRenderer();
    const context = createContext<i32>(7i32);
    renderer.mount(<Counter context={ &context} />);
    const button = renderer.queryFirst(kindButton());
    if (button === undefined || renderer.accessibilityRole(button!) !== 4 || renderer.accessibilityLabelLength(button!) !== 9usize) {
      renderer.unmount();
      return 10;
    }
    renderer.focus(button!);
    if (!renderer.isFocused(button!)) {
      renderer.unmount();
      return 11;
    }
    setUpdateCallback(notifyUpdate);
    renderer.simulatePress(button!);
    renderer.update(<Counter context={ &context} />);
    const text = findFirst(renderer.rootElement(), kindText());
    let validText = false;
    if (text !== undefined) {
      validText = text!.textLength() === 8usize;
    }
    let validHooks = false;
    unsafe {
      validHooks = validText && latestCount === 1i32 && latestReduced === 1i32 && latestMemo === 0i32 && latestRef === 1i32 && latestTheme === 7i32 && stableId === latestId && layoutRuns === 1i32 && passiveRuns === 1i32 && updateNotifications === 1i32;
    }
    if (!validHooks) {
      renderer.unmount();
      return 12;
    }
    context.provide(9i32);
    renderer.update(<Counter context={ &context} />);
    unsafe {
      if (latestTheme !== 9i32) {
        renderer.unmount();
        return 14;
      }
    }
    renderer.unmount();
    let validCleanup = false;
    unsafe {
      validCleanup = cleanups === 2i32;
    }
    clearHooks();
    if (!validCleanup) {
      return 15;
    }
    return 0;
  }
