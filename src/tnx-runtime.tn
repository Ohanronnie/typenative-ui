export function hostChildCount(element: &Element): usize {
  return element.childCount();
}
export function hostChildAt(element: &Element, index: usize): &Element | undefined {
  return element.childAt(index);
}
export function hostSetChild(element: &mut Element, index: usize, child: Element): bool {
  return element.setChild(index, move child);
}
export function dispatchPress(element: &Element): void {
  element.invokeAction();
}
export function focusElement(element: &Element): void {
  element.setFocused(true);
}
export function isFocused(element: &Element): bool {
  return element.isFocused();
}
export function leaf(): Element {
  return Element.empty();
}
export function kindEmpty(): i32 {
  return 0;
}
export function kindFunction(): i32 {
  return 1;
}
export function kindView(): i32 {
  return 2;
}
