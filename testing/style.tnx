import { Text, styledView } from "../src/components";
import { EmptyProps, Style, points, styleSetHeight, styleSetPadding, styleSetWidth } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element, hostChildAt } from "../src/tnx-runtime";
import { lengthEquals } from "../src/tnx-runtime";

function Root(props: EmptyProps): Element {
  const style = new Style();
  styleSetWidth( &mut style, points(120.0f32));
  styleSetHeight( &mut style, points(80.0f32));
  styleSetPadding( &mut style, points(4.0f32));
  const child = Text({
    children: "ok",
  });
  return styledView( &style, move child);
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  const root = renderer.rootElement();
  const content = hostChildAt(root, 0usize);
  const actual = root.style();
  const expectedWidth = points(120.0f32);
  const expectedHeight = points(80.0f32);
  const expectedPadding = points(4.0f32);
  if (!root.hasStyle() || !lengthEquals( &actual.width, &expectedWidth) || !lengthEquals( &actual.height, &expectedHeight) || !lengthEquals( &actual.padding, &expectedPadding)) {
    renderer.unmount();
    return 10;
  }
  if (content === undefined || content!.textLength() !== 2usize) {
    renderer.unmount();
    return 11;
  }
  renderer.unmount();
  return 0;
}
