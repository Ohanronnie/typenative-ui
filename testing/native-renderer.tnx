import { nullPointer } from "std/alloc";
import { String } from "std/string";
import { Button, Text, TextInput, View, Window } from "../src/components";
import { useState } from "../src/hooks/hooks";
import { NativeRenderer } from "../src/platform/macos";
import { Element, ElementRef, KeyboardType, createElementRef, hostChildAt, hostChildCount, kindTextInput } from "../src/tnx-runtime";

static mut textChangeCount: i32 = 0;
static mut submitCount: i32 = 0;
static mut focusCount: i32 = 0;
static mut blurCount: i32 = 0;
struct SmokeProps {
  public inputRef: &ElementRef;
  public buttonRef: &ElementRef;
}
function elementKindByIdentity(element: &Element, identity: u64): i32 {
  if (element.hasMountIdentity() && element.mountedIdentity() === identity) {
    return element.kind();
  }
  let index: usize = 0;
  while (index<hostChildCount(element)) {
    const child = hostChildAt(element, index);
    if (child !== undefined) {
      const found = elementKindByIdentity(child!, identity);
      if (found !== 0i32) {
        return found;
      }
    }
    index = index + 1usize;
  }
  return 0;
}
function elementValueByIdentity(element: &Element, identity: u64): string {
  if (element.hasMountIdentity() && element.mountedIdentity() === identity) {
    return element.value();
  }
  let index: usize = 0;
  while (index<hostChildCount(element)) {
    const child = hostChildAt(element, index);
    if (child !== undefined) {
      const found = elementValueByIdentity(child!, identity);
      if (found.byteLength !== 0usize) {
        return found;
      }
    }
    index = index + 1usize;
  }
  return String("");
}
function elementHasSubmitByIdentity(element: &Element, identity: u64): bool {
  if (element.hasMountIdentity() && element.mountedIdentity() === identity) {
    return element.hasSubmit();
  }
  let index: usize = 0;
  while (index<hostChildCount(element)) {
    const child = hostChildAt(element, index);
    if (child !== undefined && elementHasSubmitByIdentity(child!, identity)) {
      return true;
    }
    index = index + 1usize;
  }
  return false;
}
function elementHasFocusChangeByIdentity(element: &Element, identity: u64): bool {
  if (element.hasMountIdentity() && element.mountedIdentity() === identity) {
    return element.hasFocusChange();
  }
  let index: usize = 0;
  while (index<hostChildCount(element)) {
    const child = hostChildAt(element, index);
    if (child !== undefined && elementHasFocusChangeByIdentity(child!, identity)) {
      return true;
    }
    index = index + 1usize;
  }
  return false;
}
function Smoke(props: SmokeProps): Element {
  const [current, setPresses] = useState<i32>(0i32);
  const press = move(): void => {
    setPresses(current + 1i32);
  };
  const change = move(_: string): void => {
    unsafe {
      textChangeCount = textChangeCount + 1i32;
    }
  };
  const submit = move(): void => {
    unsafe {
      submitCount = submitCount + 1i32;
    }
  };
  const focus = move(): void => {
    unsafe {
      focusCount = focusCount + 1i32;
    }
  };
  const blur = move(): void => {
    unsafe {
      blurCount = blurCount + 1i32;
    }
  };
  let label = String("Press 0");
  if (current !== 0i32) {
    label = String("Press 1");
  }
  return <Window title="TypeNative Native Smoke">
    <View>
      <Text>Hello</Text>
      <Text>{label}</Text>
      <Button onPress={press} elementRef={props.buttonRef}>Press</Button>
      <TextInput defaultValue={String("héllo")} placeholder={String("Name")} onChangeText={change} onSubmitEditing={submit} onFocus={focus} onBlur={blur} editable={true} selection={{ start: 1usize, end: 3usize }} keyboardType={KeyboardType.Email} elementRef={props.inputRef} />
    </View>
  </Window>;
}
function main(): i32 {
  let inputRef = createElementRef();
  let buttonRef = createElementRef();
  using renderer = new NativeRenderer();
  const factory =(): Element => <Smoke inputRef={ &inputRef} buttonRef={ &buttonRef} />;
  if (!renderer.mountFactory(move factory)) {
    return 1;
  }
  if (!renderer.isMounted() || !renderer.hasWindow()) {
    return 2;
  }
  if (!inputRef.isAttached()) {
    return 3;
  }
  if (!buttonRef.isAttached()) {
    return 4;
  }
  const buttonIdentity = buttonRef.nodeIdentity();
  if (buttonIdentity === undefined) {
    return 5;
  }
  const initialIdentity = inputRef.nodeIdentity();
  if (initialIdentity === undefined) {
    return 10;
  }
  if (elementKindByIdentity(renderer.rootElement(), initialIdentity!) !== kindTextInput()) {
    return 19;
  }
  if (elementValueByIdentity(renderer.rootElement(), initialIdentity!) !== "héllo") {
    return 20;
  }
  if (renderer.inputValue(initialIdentity!) !== "héllo") {
    return 11;
  }
  if (renderer.inputPlaceholder(initialIdentity!) !== "Name") {
    return 18;
  }
  if (!elementHasSubmitByIdentity(renderer.rootElement(), initialIdentity!)) {
    return 121;
  }
  if (!elementHasFocusChangeByIdentity(renderer.rootElement(), initialIdentity!)) {
    return 122;
  }
  unsafe {
    const windowPointer = renderer.windowHandle();
    if (windowPointer === nullPointer<u8>()) {
      return 6;
    }
    renderer.dispatchAction(buttonIdentity!);
    if (renderer.mutationCount() === 0usize) {
      return 7;
    }
    if (renderer.windowHandle() !== windowPointer) {
      return 8;
    }
  }
  if (!buttonRef.isAttached()) {
    return 9;
  }
  const identity = inputRef.nodeIdentity();
  if (identity === undefined) {
    return 10;
  }
  if (!elementHasSubmitByIdentity(renderer.rootElement(), identity!)) {
    return 123;
  }
  if (!elementHasFocusChangeByIdentity(renderer.rootElement(), identity!)) {
    return 124;
  }
  if (!renderer.focusIdentity(identity!)) {
    return 12;
  }
  const focusedIdentity = renderer.focusedIdentity();
  if (focusedIdentity === undefined || focusedIdentity! !== identity!) {
    return 144;
  }
  unsafe {
    if (focusCount === 0i32) {
      return 145;
    }
  }
  const selection = renderer.inputSelection(identity!);
  if (selection.start !== 1usize || selection.end !== 3usize) {
    return 13;
  }
  if (!renderer.dispatchSubmit(identity!)) {
    return 125;
  }
  renderer.dispatchFocusChange(identity!, false);
  unsafe {
    if (submitCount !== 1i32) {
      return 141;
    }
    if (focusCount === 0i32) {
      return 142;
    }
    if (blurCount === 0i32) {
      return 143;
    }
  }
  if (!renderer.dispatchTextChange(identity!, String("typed"))) {
    return 15;
  }
  unsafe {
    if (textChangeCount !== 1i32) {
      return 16;
    }
  }
  renderer.close();
  if (inputRef.isAttached()) {
    return 17;
  }
  if (buttonRef.isAttached()) {
    return 18;
  }
  return 0;
}
