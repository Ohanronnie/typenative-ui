import { Button } from "../src/components";
import { EmptyProps } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { AccessibilityRole, Element, kindButton } from "../src/tnx-runtime";

static mut presses: i32 = 0;
function hit(): void {
  unsafe {
    presses = presses + 1i32;
  }
}
function Root(props: EmptyProps): Element {
  return <Button onPress={hit}>Increment</Button>;
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  const button = renderer.rootElement();
  if (button.kind() !== kindButton()) {
    renderer.unmount();
    return 10;
  }
  if (!renderer.hasAccessibilityRole(button, AccessibilityRole.Button) || renderer.accessibilityLabelLength(button) !== 9usize) {
    renderer.unmount();
    return 11;
  }
  renderer.focus(button);
  if (!renderer.isFocused(button)) {
    renderer.unmount();
    return 12;
  }
  renderer.simulatePress(button);
  unsafe {
    if (presses !== 1i32) {
      renderer.unmount();
      return 13;
    }
  }
  renderer.update(<Root />);
  const updated = renderer.rootElement();
  if (updated.kind() !== kindButton()) {
    renderer.unmount();
    return 14;
  }
  renderer.simulatePress(updated);
  renderer.unmount();
  unsafe {
    if (presses !== 2i32) {
      return 15;
    }
  }
  return 0;
}
