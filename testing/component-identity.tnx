import { HeadlessRenderer } from "../src/renderer/headless";
import { createText, Element, createFragmentElements, hostChildAt, createElement, keyText } from "../src/tnx-runtime";

static mut firstEffects: i32 = 0;
static mut secondEffects: i32 = 0;
static mut firstCleanups: i32 = 0;
static mut secondCleanups: i32 = 0;
static mut seenA: i32 = 0;
static mut seenB: i32 = 0;
function noop(): void {
}
function firstCleanup(): void {
  unsafe {
    firstCleanups = firstCleanups + 1i32;
  }
}
function secondCleanup(): void {
  unsafe {
    secondCleanups = secondCleanups + 1i32;
  }
}
function firstEffect(): Cleanup {
  unsafe {
    firstEffects = firstEffects + 1i32;
  }
  return firstCleanup;
}
function secondEffect(): Cleanup {
  unsafe {
    secondEffects = secondEffects + 1i32;
  }
  return secondCleanup;
}
function stableDependencies(): Array<u64> {
  const values = new Array<u64>({
    capacity: 1usize,
  });
  values.push(1u64);
  return move values;
}
function First(props: EmptyProps): Element {
  useEffect(firstEffect, stableDependencies());
  return <Text key={42}>first</Text>;
}
function Second(props: EmptyProps): Element {
  useEffect(secondEffect, stableDependencies());
  return <Text>second</Text>;
}
struct ItemProps {
  public id: i32;
  public seed: i32;
}
function Item(props: ItemProps): Element {
  const[current, _setCurrent] = useState<i32>(props.seed);
  unsafe {
    if (props.id === 1i32) {
      seenA = current;
    } else {
      seenB = current;
    }
  }
  return createText("item");
}
function list(reverse: bool): Element {
  const children = new Array<Element>({
    capacity: 2
  });
  if (!reverse) {
    children.push(createElement<ItemProps>(Item, {
      id: 1i32, seed: 10i32,
    }, keyText(String("a"))));
    children.push(createElement<ItemProps>(Item, {
      id: 2i32, seed: 20i32,
    }, keyText(String("b"))));
  } else {
    children.push(createElement<ItemProps>(Item, {
      id: 2i32, seed: 20i32,
    }, keyText(String("b"))));
    children.push(createElement<ItemProps>(Item, {
      id: 1i32, seed: 10i32,
    }, keyText(String("a"))));
  }
  return createFragmentElements(move children);
}
function singleItem(changedKey: bool): Element {
  const children = new Array<Element>({
    capacity: 1
  });
  let seed: i32 = 10;
  if (changedKey) {
    seed = 30i32;
  }
  if (changedKey) {
    children.push(createElement<ItemProps>(Item, {
      id: 1i32, seed: seed,
    }, keyText(String("remounted"))));
  } else {
    children.push(createElement<ItemProps>(Item, {
      id: 1i32, seed: seed,
    }, keyText(String("stable"))));
  }
  return createFragmentElements(move children);
}
function main(): i32 {
  const first = createElement<EmptyProps>(First, {
  }, keyText(String("same")));
  const second = createElement<EmptyProps>(Second, {
  }, keyText(String("same")));
  if (first.sameComponent( &second)) {
    first.dispose();
    second.dispose();
    return 10;
  }
  first.dispose();
  second.dispose();
  {
    using renderer = new HeadlessRenderer();
    renderer.mount(createElement<EmptyProps>(First, {
    }, keyText(String("same"))));
    unsafe {
      if (firstEffects !== 1i32 || secondEffects !== 0i32) {
        renderer.unmount();
        return 11;
      }
    }
    renderer.update(createElement<EmptyProps>(Second, {
    }, keyText(String("same"))));
    unsafe {
      if (firstCleanups !== 1i32 || secondEffects !== 1i32) {
        renderer.unmount();
        return 12;
      }
    }
    renderer.unmount();
  }
  unsafe {
    if (secondCleanups !== 1i32) {
      return 13;
    }
  }
  {
    using keyed = new HeadlessRenderer();
    keyed.mount(list(false));
    unsafe {
      if (seenA !== 10i32 || seenB !== 20i32) {
        keyed.unmount();
        return 14;
      }
    }
    keyed.update(list(true));
    unsafe {
      if (seenA !== 10i32 || seenB !== 20i32) {
        keyed.unmount();
        return 15;
      }
    }
    const firstChild = hostChildAt(keyed.rootElement(), 0usize);
    const secondChild = hostChildAt(keyed.rootElement(), 1usize);
    if (firstChild === undefined || secondChild === undefined || firstChild!.textLength() !== 4usize || secondChild!.textLength() !== 4usize) {
      keyed.unmount();
      return 16;
    }
    keyed.unmount();
  }
  {
    using remount = new HeadlessRenderer();
    remount.mount(singleItem(false));
    remount.update(singleItem(true));
    unsafe {
      if (seenA !== 30i32) {
        remount.unmount();
        return 17;
      }
    }
    remount.unmount();
  }
  return 0;
}
