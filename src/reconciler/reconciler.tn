declare extern "C" {
  function tn_bytes_read_u8(bytes: *const u8, length: c_size, index: c_size, value: *mut u8): i32;
  function tn_bytes_write_u8(bytes: *mut u8, length: c_size, index: c_size, value: u8): i32;
