import { Disposable } from "std/core";
import { DuplicateKeyDiagnostic, Reconciler } from "../reconciler/reconciler";
import { AccessibilityRole, Element, accessibilityRoleCode, dispatchPress, hostChildAt, isFocused } from "../tnx-runtime";

export class HeadlessRenderer implements Disposable {
  private reconciler: Reconciler;
  public constructor() {
    this.reconciler = new Reconciler();
  }
  public mount(root: Element): void {
    this.reconciler.mount(move root);
  }
  public update(root: Element): void {
    this.reconciler.update(move root);
  }
  public unmount(): void {
    this.reconciler.unmount();
  }
  public [Symbol.dispose](): void {
    this.unmount();
  }
  public mutationCount(): usize {
    return this.reconciler.mutationCount();
  }
  public lastMutationKind(): i32 {
    return this.reconciler.lastMutationKind();
  }
  public mutationAt(index: usize): i32 {
    const mutation = this.reconciler.mutationAt(index);
    if (mutation === undefined) {
      return 0;
    }
    return mutation!.kind;
  }
  public nodeCount(): usize {
    return this.reconciler.nodeCount();
  }
  public rootElement(): &Element {
    return this.reconciler.rootElement();
  }
  public simulatePress(element: &Element): void {
    this.reconciler.beginBatch();
    dispatchPress(element);
    this.reconciler.endBatch();
  }
  public simulateTextChange(element: &Element, value: string): bool {
    this.reconciler.beginBatch();
    const invoked = element.invokeTextChange(move value);
    this.reconciler.endBatch();
    return invoked;
  }
  public simulateBooleanChange(element: &Element, value: bool): bool {
    this.reconciler.beginBatch();
    const invoked = element.invokeBooleanChange(value);
    this.reconciler.endBatch();
    return invoked;
  }
  public simulateNumericChange(element: &Element, value: f32): bool {
    this.reconciler.beginBatch();
    const invoked = element.invokeNumericChange(value);
    this.reconciler.endBatch();
    return invoked;
  }
  public simulateVisibleRangeChange(element: &Element, firstIndex: usize): bool {
    if (!element.isVirtualized() || element.virtualFirstIndex() === firstIndex) {
      return false;
    }
    this.reconciler.beginBatch();
    const invoked = element.invokeVisibleRangeChange(firstIndex);
    this.reconciler.endBatch();
    return invoked;
  }
  public focus(element: &Element): void {
    this.reconciler.focusElement(element);
  }
  public isFocused(element: &Element): bool {
    return isFocused(element);
  }
  public hasKind(kind: i32): bool {
    if (!this.reconciler.isMounted()) {
      return false;
    }
    return containsKind(this.reconciler.rootElement(), kind);
  }
  public textLengthFirst(kind: i32): usize {
    if (!this.reconciler.isMounted()) {
      return 0;
    }
    return firstTextLength(this.reconciler.rootElement(), kind);
  }
  public simulatePressFirst(kind: i32): void {
    if (this.reconciler.isMounted()) {
      this.reconciler.beginBatch();
      invokeFirst(this.reconciler.rootElement(), kind);
      this.reconciler.endBatch();
    }
  }
  public focusFirst(kind: i32): void {
    if (this.reconciler.isMounted()) {
      this.reconciler.focusFirst(kind);
    }
  }
  public isFocusedFirst(kind: i32): bool {
    if (!this.reconciler.isMounted()) {
      return false;
    }
    return findFocused(this.reconciler.rootElement(), kind);
  }
  public accessibilityRole(element: &Element): AccessibilityRole {
    return element.accessibilityRole();
  }
  public hasAccessibilityRole(element: &Element, role: AccessibilityRole): bool {
    return element.accessibilityRoleCode() === accessibilityRoleCode( &role);
  }
  public accessibilityLabelLength(element: &Element): usize {
    return element.textLength();
  }
  public hookComponentCount(): usize {
    return this.reconciler.hookComponentCount();
  }
  public duplicateKeyCount(): usize {
    return this.reconciler.duplicateKeyCount();
  }
  public duplicateKeyAt(index: usize): DuplicateKeyDiagnostic | undefined {
    return this.reconciler.duplicateKeyAt(index);
  }
  public hasDiagnostics(): bool {
    return this.reconciler.hasDiagnostics();
  }
  public setUpdateCallback(callback: () => void): void {
    this.reconciler.setUpdateCallback(move callback);
  }
  public clearUpdateCallback(): void {
    this.reconciler.clearUpdateCallback();
  }
}
function containsKind(element: &Element, kind: i32): bool {
  if (element.kind() === kind) {
    return true;
  }
  let index: usize = 0;
  while (index<element.childCount()) {
    const child = hostChildAt(element, index);
    if (child !== undefined) {
      if (containsKind(child!, kind)) {
        return true;
      }
    }
    index = index + 1usize;
  }
  return false;
}
function firstTextLength(element: &Element, kind: i32): usize {
  if (element.kind() === kind) {
    return element.textLength();
  }
  let index: usize = 0;
  while (index<element.childCount()) {
    const child = hostChildAt(element, index);
    if (child !== undefined) {
      const length = firstTextLength(child!, kind);
      if (length !== 0usize) {
        return length;
      }
    }
    index = index + 1usize;
  }
  return 0;
}
function invokeFirst(element: &Element, kind: i32): bool {
  if (element.kind() === kind) {
    dispatchPress(element);
    return true;
  }
  let index: usize = 0;
  while (index<element.childCount()) {
    const child = hostChildAt(element, index);
    if (child !== undefined && invokeFirst(child!, kind)) {
      return true;
    }
    index = index + 1usize;
  }
  return false;
}
function findFocused(element: &Element, kind: i32): bool {
  if (element.kind() === kind) {
    return element.isFocused();
  }
  let index: usize = 0;
  while (index<element.childCount()) {
    const child = hostChildAt(element, index);
    if (child !== undefined && findFocused(child!, kind)) {
      return true;
    }
    index = index + 1usize;
  }
  return false;
}
