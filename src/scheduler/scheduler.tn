import { Deque, Set } from "std/collections";
import { Disposable } from "std/core";
import { Condition, Mutex, condition } from "std/sync";
import { threadId } from "std/thread";
import { Instant } from "std/time";

export enum Priority {
  Immediate, UserBlocking, Normal, Low, Idle,
}
function highPriority(priority: Priority): bool {
  return switch(priority) {
    case Priority.Immediate: true, case Priority.UserBlocking: true, case Priority.Normal: false, case Priority.Low: false, case Priority.Idle: false,
  };
}
export struct WorkItem {
  public priority: Priority;
  public sequence: u64;
  public callback: () => void;
}
function monotonicNanoseconds(): u64 {
  const instant = Instant.now();
  return instant.timestampNanoseconds;
}
class WorkQueue {
  private immediate: Deque<WorkItem>;
  private userBlocking: Deque<WorkItem>;
  private normal: Deque<WorkItem>;
  private low: Deque<WorkItem>;
  private idle: Deque<WorkItem>;
  private scheduled: Set<u64>;
  private cancelled: Set<u64>;
  private queuedCount: usize;
  private liveCount: usize;
  public constructor() {
    this.immediate = new Deque<WorkItem>({
      capacity: 0usize
    });
    this.userBlocking = new Deque<WorkItem>({
      capacity: 0usize
    });
    this.normal = new Deque<WorkItem>({
      capacity: 0usize
    });
    this.low = new Deque<WorkItem>({
      capacity: 0usize
    });
    this.idle = new Deque<WorkItem>({
      capacity: 0usize
    });
    this.scheduled = new Set<u64>({
      capacity: 0usize
    });
    this.cancelled = new Set<u64>({
      capacity: 0usize
    });
    this.queuedCount = 0usize;
    this.liveCount = 0usize;
  }
  public push(item: WorkItem): void {
    const sequence = item.sequence;
    switch(item.priority) {
      case Priority.Immediate: this.immediate.pushBack(move item), case Priority.UserBlocking: this.userBlocking.pushBack(move item), case Priority.Normal: this.normal.pushBack(move item), case Priority.Low: this.low.pushBack(move item), case Priority.Idle: this.idle.pushBack(move item),
    };
    this.scheduled.add(sequence);
    this.queuedCount = this.queuedCount + 1usize;
    this.liveCount = this.liveCount + 1usize;
  }
  private dequeue(highStreak: usize): WorkItem | undefined {
    if (highStreak >= 8usize) {
      if (this.normal.length > 0usize) {
        return this.normal.popFront();
      }
      if (this.low.length > 0usize) {
        return this.low.popFront();
      }
      if (this.idle.length > 0usize) {
        return this.idle.popFront();
      }
    }
    if (this.immediate.length > 0usize) {
      return this.immediate.popFront();
    }
    if (this.userBlocking.length > 0usize) {
      return this.userBlocking.popFront();
    }
    if (this.normal.length > 0usize) {
      return this.normal.popFront();
    }
    if (this.low.length > 0usize) {
      return this.low.popFront();
    }
    if (this.idle.length > 0usize) {
      return this.idle.popFront();
    }
    return undefined;
  }
  public take(highStreak: usize): WorkItem | undefined {
    while (this.queuedCount > 0usize) {
      const item = this.dequeue(highStreak);
      if (item === undefined) {
        return undefined;
      }
      const sequence = item!.sequence;
      this.queuedCount = this.queuedCount - 1usize;
      this.scheduled.delete( &sequence);
      if (this.cancelled.has( &sequence)) {
        this.cancelled.delete( &sequence);
        continue;
      }
      this.liveCount = this.liveCount - 1usize;
      return item;
    }
    return undefined;
  }
  public clear(): void {
    this.immediate.clear();
    this.userBlocking.clear();
    this.normal.clear();
    this.low.clear();
    this.idle.clear();
    this.scheduled.clear();
    this.cancelled.clear();
    this.queuedCount = 0usize;
    this.liveCount = 0usize;
  }
  public hasLive(): bool {
    return this.liveCount > 0usize;
  }
  public pendingCount(): usize {
    return this.liveCount;
  }
  public cancel(sequence: u64): bool {
    if (!this.scheduled.has( &sequence)) {
      return false;
    }
    if (!this.cancelled.add(sequence)) {
      return false;
    }
    this.liveCount = this.liveCount - 1usize;
    return true;
  }
}
function queueItem(queue: &mut WorkQueue, priority: Priority, sequence: u64, callback: () => void): void {
  queue.push({
    priority: priority, sequence: sequence, callback: move callback,
  });
}
export class Scheduler implements Disposable {
  private queue: Mutex<WorkQueue>;
  private wakeup: Condition;
  private nextSequence: u64;
  private highStreak: usize;
  private running: bool;
  private closed: bool;
  private ownerThread: u64;
  public constructor() {
    this.queue = new Mutex<WorkQueue>(new WorkQueue());
    this.wakeup = condition();
    this.nextSequence = 0u64;
    this.highStreak = 0usize;
    this.running = false;
    this.closed = false;
    this.ownerThread = threadId();
  }
  private ownerOnly(): bool {
    return threadId() === this.ownerThread;
  }
  public owner(): u64 {
    return this.ownerThread;
  }
  public schedule(callback: () => void): u64 {
    return this.scheduleWithPriority(Priority.Normal, move callback);
  }
  public scheduleWithPriority(priority: Priority, callback: () => void): u64 {
    using locked = this.queue.lock();
    if (this.closed) {
      return 0;
    }
    const sequence = this.nextSequence;
    this.nextSequence = this.nextSequence + 1u64;
    queueItem(locked.getMut(), priority, sequence, move callback);
    this.wakeup.signal();
    return sequence;
  }
  public hasWork(): bool {
    using locked = this.queue.lock();
    return locked.getMut().hasLive();
  }
  public waitForWork(): bool {
    using locked = this.queue.lock();
    while (!this.closed && !locked.getMut().hasLive()) {
      unsafe {
        this.wakeup.wait(this.queue.rawHandle());
      }
    }
    return !this.closed && locked.getMut().hasLive();
  }
  public runNext(): bool {
    if (!this.ownerOnly()) {
      return false;
    }
    let item: WorkItem | undefined = undefined;
    {
      using locked = this.queue.lock();
      item = locked.getMut().take(this.highStreak);
      if (item !== undefined) {
        if (highPriority(item!.priority)) {
          this.highStreak = this.highStreak + 1usize;
        } else {
          this.highStreak = 0usize;
        }
        this.running = true;
      }
    }
    if (item === undefined) {
      return false;
    }
    item!.callback();
    this.running = false;
    return true;
  }
  public flush(limit: usize): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while (count<limit && this.runNext()) {
      count = count + 1usize;
    }
    return count;
  }
  public flushUntil(deadlineNanoseconds: u64): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while ((monotonicNanoseconds() < deadlineNanoseconds) && this.runNext()) {
      count = count + 1usize;
    }
    return count;
  }
  public flushFor(budgetNanoseconds: u64): usize {
    const start: u64 = monotonicNanoseconds();
    let deadline = start + budgetNanoseconds;
    if (deadline<start) {
      deadline = 18446744073709551615u64;
    }
    return this.flushUntil(deadline);
  }
  public isRunning(): bool {
    return this.running;
  }
  public cancel(sequence: u64): bool {
    using locked = this.queue.lock();
    return locked.getMut().cancel(sequence);
  }
  public pendingCount(): usize {
    using locked = this.queue.lock();
    return locked.getMut().pendingCount();
  }
  public clear(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    locked.getMut().clear();
    this.running = false;
  }
  public close(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    if (!this.closed) {
      this.closed = true;
      locked.getMut().clear();
      this.wakeup.broadcast();
    }
  }
  public [Symbol.dispose](): void {
    this.close();
  }
}
export class UiScheduler implements Disposable {
  private queue: Mutex<WorkQueue>;
  private wakeup: Condition;
  private nextSequence: u64;
  private highStreak: usize;
  private closed: bool;
  private ownerThread: u64;
  public constructor() {
    this.queue = new Mutex<WorkQueue>(new WorkQueue());
    this.wakeup = condition();
    this.nextSequence = 0u64;
    this.highStreak = 0usize;
    this.closed = false;
    this.ownerThread = threadId();
  }
  private ownerOnly(): bool {
    return threadId() === this.ownerThread;
  }
  public owner(): u64 {
    return this.ownerThread;
  }
  public post(priority: Priority, callback: () => void): u64 | undefined {
    using locked = this.queue.lock();
    if (this.closed) {
      return undefined;
    }
    const sequence = this.nextSequence;
    this.nextSequence = this.nextSequence + 1u64;
    locked.getMut().push({
      priority: priority, sequence: sequence, callback: move callback,
    });
    this.wakeup.signal();
    return sequence;
  }
  public cancel(sequence: u64): bool {
    using locked = this.queue.lock();
    return locked.getMut().cancel(sequence);
  }
  public waitForWork(): bool {
    using locked = this.queue.lock();
    while (!this.closed && !locked.getMut().hasLive()) {
      unsafe {
        this.wakeup.wait(this.queue.rawHandle());
      }
    }
    return !this.closed && locked.getMut().hasLive();
  }
  public drain(limit: usize): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while (count<limit) {
      let job: WorkItem | undefined = undefined;
      {
        using locked = this.queue.lock();
        job = locked.getMut().take(this.highStreak);
        if (job === undefined) {
          break;
        }
        if (job !== undefined) {
          if (highPriority(job!.priority)) {
            this.highStreak = this.highStreak + 1usize;
          } else {
            this.highStreak = 0usize;
          }
        }
      }
      if (job !== undefined) {
        job!.callback();
        count = count + 1usize;
      }
    }
    return count;
  }
  public drainUntil(deadlineNanoseconds: u64): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while (monotonicNanoseconds() < deadlineNanoseconds) {
      let job: WorkItem | undefined = undefined;
      {
        using locked = this.queue.lock();
        job = locked.getMut().take(this.highStreak);
        if (job === undefined) {
          break;
        }
        if (highPriority(job!.priority)) {
          this.highStreak = this.highStreak + 1usize;
        } else {
          this.highStreak = 0usize;
        }
      }
      if (job !== undefined) {
        job!.callback();
        count = count + 1usize;
      }
    }
    return count;
  }
  public drainFor(budgetNanoseconds: u64): usize {
    const start: u64 = monotonicNanoseconds();
    let deadline = start + budgetNanoseconds;
    if (deadline<start) {
      deadline = 18446744073709551615u64;
    }
    return this.drainUntil(deadline);
  }
  public pendingCount(): usize {
    using locked = this.queue.lock();
    return locked.getMut().pendingCount();
  }
  public close(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    if (!this.closed) {
      this.closed = true;
      locked.getMut().clear();
      this.wakeup.broadcast();
    }
  }
  public [Symbol.dispose](): void {
    this.close();
  }
}
export function schedule(scheduler: Scheduler, callback: () => void): u64 {
  return scheduler.schedule(move callback);
}
export function schedulePriority(scheduler: Scheduler, priority: Priority, callback: () => void): u64 {
  return scheduler.scheduleWithPriority(priority, move callback);
}
export function flushAll(scheduler: Scheduler): usize {
  return scheduler.flush(18446744073709551615usize);
}
