export function resolveTree(element: Element): Element {
  let current = move element;
  while (current.kind() === kindFunction()) {
    current = current.renderNow();
  }
  let index: usize = 0;
  while (index<hostChildCount(current)) {
    const child = hostChildAt(current, index);
    if (child !== undefined) {
      const resolved = resolveTree(child!);
      hostSetChild(current, index, move resolved);
    }
    index = index + 1usize;
  }
  return move current;
}
export function renderTree(element: Element): Element {
  beginHookPass();
  const resolved = resolveTree(move element);
  finishHookPass();
  return move resolved;
}
function sameNode(previous: Element, next: Element): bool {
  return previous.kind() === next.kind() && previous.typeId() === next.typeId() && previous.keyId() === next.keyId();
}
function hasKeyedChildren(parent: Element): bool {
  let cursor: usize = 0;
  while (cursor<hostChildCount(parent)) {
    const child = hostChildAt(parent, cursor);
    if (child !== undefined && child!.keyId() !== 0u64) {
      return true;
    }
    cursor = cursor + 1usize;
  }
  return false;
}
function matchingChild(previous: Element, next: Element, index: usize, keyIndex: &KeyIndex): usize | undefined {
  if (next.keyId() === 0u64) {
    if (index<hostChildCount(previous)) {
      return index;
    }
    return undefined;
  }
  return keyIndexGet(keyIndex, next.keyId());
}
function diffTree(previous: Element, next: Element, nodeId: i32, parentId: i32, index: usize, mutations: &mut Array<Mutation >): void {
  if (!sameNode(previous, next)) {
    mutations.push({
      kind: mutationReplace(), nodeId: nodeId, parentId: parentId, fromIndex: index, toIndex: index,
    });
    return;
  }
  if (previous.revision() !== next.revision() || previous.textLength() !== next.textLength() || previous.textHash() !== next.textHash()) {
    mutations.push({
      kind: mutationUpdate(), nodeId: nodeId, parentId: parentId, fromIndex: index, toIndex: index,
    });
  }
  if (hostChildCount(previous) === 0usize && hostChildCount(next) === 0usize) {
    return;
  }
  let previousKeyIndex = emptyKeyIndex();
  let nextKeyIndex = emptyKeyIndex();
  if (hasKeyedChildren(previous)) {
    previousKeyIndex = newKeyIndex(hostChildCount(previous) * 2usize);
  }
  if (hasKeyedChildren(next)) {
    nextKeyIndex = newKeyIndex(hostChildCount(next) * 2usize);
  }
  let mapIndex: usize = 0;
  while (mapIndex<hostChildCount(previous)) {
    const mappedChild = hostChildAt(previous, mapIndex);
    if (mappedChild !== undefined && mappedChild!.keyId() !== 0u64) {
      keyIndexInsert( &mut previousKeyIndex, mappedChild!.keyId(), mapIndex);
    }
    mapIndex = mapIndex + 1usize;
  }
  mapIndex = 0usize;
  while (mapIndex<hostChildCount(next)) {
    const mappedChild = hostChildAt(next, mapIndex);
    if (mappedChild !== undefined && mappedChild!.keyId() !== 0u64) {
      keyIndexInsert( &mut nextKeyIndex, mappedChild!.keyId(), mapIndex);
    }
    mapIndex = mapIndex + 1usize;
  }
  let nextIndex: usize = 0;
  while (nextIndex<hostChildCount(next)) {
    const nextChild = hostChildAt(next, nextIndex);
    if (nextChild !== undefined) {
      const oldIndex = matchingChild(previous, nextChild!, nextIndex, &previousKeyIndex);
      if (oldIndex === undefined) {
        mutations.push({
          kind: mutationInsert(), nodeId: - 1i32, parentId: nodeId, fromIndex: 0usize, toIndex: nextIndex,
        });
      } else {
        const previousIndex = oldIndex!;
        if (previousIndex !== nextIndex && nextChild!.keyId() !== 0u64) {
          mutations.push({
            kind: mutationMove(), nodeId: - 1i32, parentId: nodeId, fromIndex: previousIndex, toIndex: nextIndex,
          });
        }
        const previousChild = hostChildAt(previous, previousIndex);
        if (previousChild !== undefined) {
          diffTree(previousChild!, nextChild!, - 1i32, nodeId, nextIndex, mutations);
        }
      }
    }
    nextIndex = nextIndex + 1usize;
  }
  let previousIndex: usize = 0;
  while (previousIndex<hostChildCount(previous)) {
    const previousChild = hostChildAt(previous, previousIndex);
    if (previousChild !== undefined) {
      const key = previousChild!.keyId();
      if ((key === 0u64 && previousIndex >= hostChildCount(next)) ||(key !== 0u64 && keyIndexGet( &nextKeyIndex, key) === undefined)) {
        mutations.push({
          kind: mutationRemove(), nodeId: - 1i32, parentId: nodeId, fromIndex: previousIndex, toIndex: 0usize,
        });
      }
    }
    previousIndex = previousIndex + 1usize;
  }
  disposeKeyIndex( &mut previousKeyIndex);
