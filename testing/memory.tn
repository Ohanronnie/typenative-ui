import { u64ToUsize } from "std/alloc";
import { BytesMut } from "std/bytes";
import { c_size } from "std/ffi";
import { EmptyProps } from "../src/core/types";
import { useState } from "../src/hooks/hooks";
import { HeadlessRenderer } from "../src/renderer/headless";
import { createElement, createText, Element, keyNone, kindText } from "../src/tnx-runtime";

declare extern "C" {
  function tn_console_write(fd: i32, bytes: *const u8, length: c_size): i32;
  function tn_runtime_allocation_count(): u64;
  function tn_runtime_free_count(): u64;
  function tn_runtime_reset_allocation_count(): void;
}
static mut updatesPerformed: u64 = 0;
static mut liveBefore: u64 = 0;
static mut liveAfter: u64 = 0;
function liveAllocations(): u64 {
  unsafe {
    const allocations = tn_runtime_allocation_count();
    const frees = tn_runtime_free_count();
    if (allocations<frees) {
      return 0;
    }
    return allocations - frees;
  }
}
function reportMetric(label: &str, value: u64): void {
  const buffer = new BytesMut({
    capacity: 64usize,
  });
  buffer.appendAscii(label);
  buffer.appendAscii("=");
  buffer.appendUnsignedDecimal(u64ToUsize(value));
  buffer.appendAscii("\n");
  unsafe {
    tn_console_write(1i32, buffer.nativePointer()as *const u8, buffer.length);
  }
}
function MillionUpdates(props: EmptyProps): Element {
  const [value, setValue] = useState<i32>(0i32);
  unsafe {
    if (updatesPerformed === 0u64) {
      liveBefore = liveAllocations();
    }
  }
  unsafe {
    if (updatesPerformed === 0u64) {
      let index: u64 = 0;
      while (index<1000000u64) {
        setValue(1i32);
        index = index + 1u64;
      }
      updatesPerformed = 1000000u64;
      liveAfter = liveAllocations();
    }
  }
  if (value === 1i32) {
    return createText("one");
  }
  return createText("zero");
}
function main(): i32 {
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  using renderer = new HeadlessRenderer();
  renderer.mount(createElement<EmptyProps>(MillionUpdates, {
  }, keyNone()));
  renderer.update(createElement<EmptyProps>(MillionUpdates, {
  }, keyNone()));
  if (renderer.textLengthFirst(kindText()) !== 3usize) {
    return 10;
  }
  unsafe {
    if (updatesPerformed !== 1000000u64 || liveBefore !== liveAfter) {
      return 11;
    }
  }
  unsafe {
    reportMetric("stateUpdates", updatesPerformed);
    reportMetric("liveBefore", liveBefore);
    reportMetric("liveAfter", liveAfter);
  }
  return 0;
}
