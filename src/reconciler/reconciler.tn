function keyIndexGet(table: &KeyIndex, key: u64): usize | undefined {
  if (table.capacity === 0usize) {
    return undefined;
  }
  let index = keyIndexHash(key) & table.mask;
  let probes = 0usize;
  while (probes<table.capacity) {
    const state = keyIndexState(table, index);
    if (state === 0u8) {
      return undefined;
    }
    if (keyIndexKey(table, index) === key) {
      return keyIndexValue(table, index);
    }
    index =(index + 1usize) & table.mask;
    probes = probes + 1usize;
  }
  return undefined;
}
function disposeKeyIndex(table: &mut KeyIndex): void {
  if (table.capacity > 0usize) {
    unsafe {
      rawFree(table.keys);
      rawFree(table.values);
      rawFree(table.states);
    }
  }
  table.keys = nullRaw();
  table.values = nullRaw();
  table.states = nullRaw();
  table.capacity = 0usize;
  table.mask = 0usize;
}
export class Reconciler implements Disposable {
  private root: *mut u8;
  private mounted: bool;
  private nextId: i32;
  private nodes: Array<i32>;
  private mutations: Array<Mutation>;
  public constructor() {
    unsafe {
      this.root = nullRaw();
    }
    this.mounted = false;
    this.nextId = 0i32;
    this.nodes = new Array<i32>({
      capacity: 0
    });
    this.mutations = new Array<Mutation>({
      capacity: 0
    });
  }
  public mount(element: Element): void {
    let pointer: *mut u8 = nullRaw();
    unsafe {
      pointer = element.takeRawForRuntime();
    }
    if (pointer === nullRaw()) {
      this.unmount();
      return;
    }
    if (this.mounted) {
      this.unmount();
    }
    unsafe {
      this.root = pointer;
    }
    this.mounted = true;
    this.resetSnapshot();
    unsafe {
      this.snapshot(Element.fromRaw(pointer), - 1i32, 0usize, true);
    }
  }
  public update(element: Element): void {
    let nextPointer: *mut u8 = nullRaw();
    unsafe {
      nextPointer = element.takeRawForRuntime();
    }
    if (nextPointer === nullRaw()) {
      return;
    }
    if (!this.mounted) {
      unsafe {
        this.root = nextPointer;
      }
      this.mounted = true;
      this.resetSnapshot();
      unsafe {
        this.snapshot(Element.fromRaw(nextPointer), - 1i32, 0usize, true);
      }
      return;
    }
    unsafe {
      const previous = Element.fromRaw(this.root);
      const next = Element.fromRaw(nextPointer);
      this.mutations.clear();
      diffTree(previous, next, 0i32, - 1i32, 0usize, &mut this.mutations);
      disposeRaw(this.root);
      this.root = nextPointer;
      this.nodes.clear();
      this.nextId = 0i32;
      this.snapshot(next, - 1i32, 0usize, false);
    }
  }
  public unmount(): void {
    if (this.root !== nullRaw()) {
      unsafe {
        disposeRaw(this.root);
        this.root = nullRaw();
      }
    }
    this.mounted = false;
    this.nodes.clear();
    this.mutations.clear();
    this.nextId = 0i32;
  }
  public [Symbol.dispose](): void {
    this.unmount();
  }
  public rootElement(): Element {
    if (!this.mounted) {
      return leaf();
    }
    unsafe {
      return Element.fromRaw(this.root);
    }
  }
  public mutationCount(): usize {
    return this.mutations.length;
  }
  public lastMutationKind(): i32 {
    if (this.mutations.length === 0usize) {
      return 0;
    }
    const mutation = this.mutations.at(this.mutations.length - 1usize);
    if (mutation === undefined) {
      return 0;
    }
    return mutation!.kind;
  }
  public mutationAt(index: usize): Mutation | undefined {
    const mutation = this.mutations.at(index);
    if (mutation === undefined) {
      return undefined;
    }
    return {
      kind: mutation!.kind, nodeId: mutation!.nodeId, parentId: mutation!.parentId, fromIndex: mutation!.fromIndex, toIndex: mutation!.toIndex,
    };
  }
  public isMounted(): bool {
    return this.mounted;
  }
  public nodeCount(): usize {
    return this.nodes.length;
  }
  private resetSnapshot(): void {
    this.nodes.clear();
    this.mutations.clear();
    this.nextId = 0i32;
  }
  private snapshot(element: Element, parent: i32, index: usize, emit: bool): i32 {
    const id = this.nextId;
    this.nextId = this.nextId + 1i32;
    this.nodes.push(id);
    if (emit) {
      this.mutations.push({
        kind: mutationCreate(), nodeId: id, parentId: parent, fromIndex: index, toIndex: index,
