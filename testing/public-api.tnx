import { EmptyProps } from "../src/core/types";
import { Button, createHeadlessRenderer, createReconciler, createScheduler, createUiScheduler, Element, Text, View, Window } from "../src/index";
import { createElement as runtimeCreateElement, kindText, keyNone } from "../src/tnx-runtime";

function hit(): void {
}
function Root(props: EmptyProps): Element {
  return <Window title="Public API">
    <View>
      <Text>Public</Text>
      <Button onPress={hit}>Go</Button>
    </View>
  </Window>;
}
function main(): i32 {
  let jsxElement = <Root />;
  let directElement = runtimeCreateElement<EmptyProps>(Root, {
  }, keyNone());
  if (!jsxElement.sameComponent( &directElement) || jsxElement.typeId() !== directElement.typeId() || !jsxElement.keyEquals( &directElement)) {
    jsxElement.dispose();
    directElement.dispose();
    return 9;
  }
  jsxElement.dispose();
  directElement.dispose();
