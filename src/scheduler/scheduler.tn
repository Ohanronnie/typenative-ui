import { Array } from "std/collections";
import { Disposable } from "std/core";
import { Condition, Mutex, condition } from "std/sync";
import { threadId } from "std/thread";

export enum Priority {
  Immediate, UserBlocking, Normal, Low, Idle,
}
function priorityValue(priority: Priority): i32 {
  return switch(priority) {
    case Priority.Immediate: 0i32, case Priority.UserBlocking: 1i32, case Priority.Normal: 2i32, case Priority.Low: 3i32, case Priority.Idle: 4i32,
  };
}
function highPriority(priority: i32): bool {
  return priority <= 1i32;
}
export struct WorkItem {
  public priority: i32;
  public sequence: u64;
  public callback: () => void;
  public cancelled: bool;
}
class WorkQueue {
  private items: Array<WorkItem>;
  public constructor() {
    this.items = new Array<WorkItem>({
      capacity: 0usize
    });
  }
  public push(item: WorkItem): void {
    this.items.push(move item);
  }
  public count(): usize {
    return this.items.length;
  }
  public at(index: usize): &WorkItem | undefined {
    return this.items.at(index);
  }
  public atMut(index: usize): &mut WorkItem | undefined {
    return this.items.atMut(index);
  }
  public removeAt(index: usize): WorkItem | undefined {
    return this.items.removeAt(index);
  }
  public clear(): void {
    this.items.clear();
  }
  public hasLive(): bool {
    let index: usize = 0;
    while (index<this.items.length) {
      const item = this.items.at(index);
      if (item !== undefined && !item!.cancelled) {
        return true;
      }
      index = index + 1usize;
    }
    return false;
  }
  public select(highStreak: usize): usize | undefined {
    if (this.items.length === 0usize) {
      return undefined;
    }
    let selected: usize | undefined = undefined;
    let index: usize = 0;
    while (index<this.items.length) {
      const candidate = this.items.at(index);
      if (candidate !== undefined && !candidate!.cancelled) {
        if (selected === undefined) {
          selected = index;
        } else {
          const current = this.items.at(selected!);
          if (current !== undefined) {
            const fair = highStreak >= 8usize && highPriority(current!.priority) && !highPriority(candidate!.priority);
            if (fair || candidate!.priority<current!.priority ||(candidate!.priority === current!.priority && candidate!.sequence<current!.sequence)) {
              selected = index;
            }
          }
        }
      }
      index = index + 1usize;
    }
    return selected;
  }
}
function queueItem(queue: &mut WorkQueue, priority: i32, sequence: u64, callback: () => void): void {
  queue.push({
    priority: priority, sequence: sequence, callback: move callback, cancelled: false,
  });
}
export class Scheduler implements Disposable {
  private queue: Mutex<WorkQueue>;
  private wakeup: Condition;
  private nextSequence: u64;
  private highStreak: usize;
  private running: bool;
  private closed: bool;
  private ownerThread: u64;
  public constructor() {
    this.queue = new Mutex<WorkQueue>(new WorkQueue());
    this.wakeup = condition();
    this.nextSequence = 0u64;
    this.highStreak = 0usize;
    this.running = false;
    this.closed = false;
    this.ownerThread = threadId();
  }
  private ownerOnly(): bool {
    return threadId() === this.ownerThread;
  }
  public owner(): u64 {
    return this.ownerThread;
  }
  public schedule(callback: () => void): u64 {
    return this.scheduleWithPriority(Priority.Normal, move callback);
  }
  public scheduleWithPriority(priority: Priority, callback: () => void): u64 {
    using locked = this.queue.lock();
    if (this.closed) {
      return 0;
    }
    const sequence = this.nextSequence;
    this.nextSequence = this.nextSequence + 1u64;
    queueItem(locked.getMut(), priorityValue(priority), sequence, move callback);
    this.wakeup.signal();
    return sequence;
  }
  public hasWork(): bool {
    using locked = this.queue.lock();
    return locked.getMut().hasLive();
  }
  public waitForWork(): bool {
    using locked = this.queue.lock();
    while (!this.closed && !locked.getMut().hasLive()) {
      unsafe {
        this.wakeup.wait(this.queue.rawHandle());
      }
    }
    return !this.closed && locked.getMut().hasLive();
  }
  public runNext(): bool {
    if (!this.ownerOnly()) {
      return false;
    }
    let item: WorkItem | undefined = undefined;
    {
      using locked = this.queue.lock();
      const selected = locked.getMut().select(this.highStreak);
      if (selected === undefined) {
        return false;
      }
      item = locked.getMut().removeAt(selected!);
      if (item !== undefined) {
        if (highPriority(item!.priority)) {
          this.highStreak = this.highStreak + 1usize;
        } else {
          this.highStreak = 0usize;
        }
        this.running = true;
      }
    }
    if (item === undefined) {
      return false;
    }
    if (!item!.cancelled) {
      item!.callback();
    }
    this.running = false;
    return true;
  }
  public flush(limit: usize): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while (count<limit && this.runNext()) {
      count = count + 1usize;
    }
    return count;
  }
  public isRunning(): bool {
    return this.running;
  }
  public cancel(sequence: u64): bool {
    using locked = this.queue.lock();
    let index: usize = 0;
    while (index<locked.getMut().count()) {
      const item = locked.getMut().atMut(index);
      if (item !== undefined && item!.sequence === sequence && !item!.cancelled) {
        item!.cancelled = true;
        locked.getMut().removeAt(index);
        return true;
      }
      index = index + 1usize;
    }
    return false;
  }
  public pendingCount(): usize {
    using locked = this.queue.lock();
    let count: usize = 0;
    let index: usize = 0;
    while (index<locked.getMut().count()) {
      const item = locked.getMut().at(index);
      if (item !== undefined && !item!.cancelled) {
        count = count + 1usize;
      }
      index = index + 1usize;
    }
    return count;
  }
  public clear(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    locked.getMut().clear();
    this.running = false;
  }
  public close(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    if (!this.closed) {
      this.closed = true;
      locked.getMut().clear();
      this.wakeup.broadcast();
    }
  }
  public [Symbol.dispose](): void {
    this.close();
  }
}
export class UiScheduler implements Disposable {
  private queue: Mutex<WorkQueue>;
  private wakeup: Condition;
  private nextSequence: u64;
  private highStreak: usize;
  private closed: bool;
  private ownerThread: u64;
  public constructor() {
    this.queue = new Mutex<WorkQueue>(new WorkQueue());
    this.wakeup = condition();
    this.nextSequence = 0u64;
    this.highStreak = 0usize;
    this.closed = false;
    this.ownerThread = threadId();
  }
  private ownerOnly(): bool {
    return threadId() === this.ownerThread;
  }
  public owner(): u64 {
    return this.ownerThread;
  }
  public post(priority: Priority, callback: () => void): u64 | undefined {
    using locked = this.queue.lock();
    if (this.closed) {
      return undefined;
    }
    const sequence = this.nextSequence;
    this.nextSequence = this.nextSequence + 1u64;
    locked.getMut().push({
      priority: priorityValue(priority), sequence: sequence, callback: move callback, cancelled: false,
    });
    this.wakeup.signal();
    return sequence;
  }
  public cancel(sequence: u64): bool {
    using locked = this.queue.lock();
    let index: usize = 0;
    while (index<locked.getMut().count()) {
      const item = locked.getMut().atMut(index);
      if (item !== undefined && item!.sequence === sequence && !item!.cancelled) {
        item!.cancelled = true;
        locked.getMut().removeAt(index);
        return true;
      }
      index = index + 1usize;
    }
    return false;
  }
  public waitForWork(): bool {
    using locked = this.queue.lock();
    while (!this.closed && !locked.getMut().hasLive()) {
      unsafe {
        this.wakeup.wait(this.queue.rawHandle());
      }
    }
    return !this.closed && locked.getMut().hasLive();
  }
  public drain(limit: usize): usize {
    if (!this.ownerOnly()) {
      return 0;
    }
    let count: usize = 0;
    while (count<limit) {
      let job: WorkItem | undefined = undefined;
      {
        using locked = this.queue.lock();
        const selected = locked.getMut().select(this.highStreak);
        if (selected === undefined) {
          break;
        }
        job = locked.getMut().removeAt(selected!);
        if (job !== undefined) {
          if (highPriority(job!.priority)) {
            this.highStreak = this.highStreak + 1usize;
          } else {
            this.highStreak = 0usize;
          }
        }
      }
      if (job !== undefined) {
        if (!job!.cancelled) {
          job!.callback();
        }
        count = count + 1usize;
      }
    }
    return count;
  }
  public pendingCount(): usize {
    using locked = this.queue.lock();
    let count: usize = 0;
    let index: usize = 0;
    while (index<locked.getMut().count()) {
      const job = locked.getMut().at(index);
      if (job !== undefined && !job!.cancelled) {
        count = count + 1usize;
      }
      index = index + 1usize;
    }
    return count;
  }
  public close(): void {
    if (!this.ownerOnly()) {
      return;
    }
    using locked = this.queue.lock();
    if (!this.closed) {
      this.closed = true;
      locked.getMut().clear();
      this.wakeup.broadcast();
    }
  }
  public [Symbol.dispose](): void {
    this.close();
  }
}
export function schedule(scheduler: Scheduler, callback: () => void): u64 {
  return scheduler.schedule(move callback);
}
export function schedulePriority(scheduler: Scheduler, priority: Priority, callback: () => void): u64 {
  return scheduler.scheduleWithPriority(priority, move callback);
}
export function flushAll(scheduler: Scheduler): usize {
  return scheduler.flush(18446744073709551615usize);
}
