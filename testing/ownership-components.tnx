import { Text, View } from "../src/components";
import { EmptyProps } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element, kindText } from "../src/tnx-runtime";

function Root(props: EmptyProps): Element {
  return <View>
    <Text>Go</Text>
  </View>;
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  const valid = renderer.hasKind(kindText()) && renderer.textLengthFirst(kindText()) === 2usize;
  renderer.unmount();
  if (valid) {
    return 0;
  }
  return 1;
}
