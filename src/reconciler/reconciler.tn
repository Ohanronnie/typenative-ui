  function tn_bytes_copy_to_at(source: *const u8, sourceLength: c_size, sourceOffset: c_size, count: c_size, destination: *mut u8, destinationLength: c_size, destinationOffset: c_size): i32;
}
function nullRaw(): *mut u8 {
  unsafe {
    return nullPointer<u8>();
  }
}
struct KeyIndex {
  public keys: *mut u8;
  public values: *mut u8;
  public states: *mut u8;
  public capacity: usize;
  public mask: usize;
}
function emptyKeyIndex(): KeyIndex {
  return {
    keys: nullRaw(), values: nullRaw(), states: nullRaw(), capacity: 0usize, mask: 0usize,
  };
}
function newKeyIndex(minimum: usize): KeyIndex {
  let capacity = 8usize;
  while (capacity<minimum) {
    capacity = capacity * 2usize;
  }
  let keys: *mut u8 = nullRaw();
  let values: *mut u8 = nullRaw();
  let states: *mut u8 = nullRaw();
  unsafe {
    keys = rawAlloc(capacity * 8usize);
    values = rawAlloc(capacity * 8usize);
    states = rawAlloc(capacity);
    let index: usize = 0;
    while (index<capacity) {
      tn_bytes_write_u8(states, capacity as c_size, index as c_size, 0u8);
      index = index + 1usize;
    }
  }
  return {
    keys: keys, values: values, states: states, capacity: capacity, mask: capacity - 1usize,
  };
}
function keyIndexHash(key: u64): usize {
  const mixed = key ^(key / 4294967296u64);
  return u64ToUsize(mixed);
}
function keyIndexState(table: &KeyIndex, index: usize): u8 {
  let state = 0u8;
  unsafe {
    tn_bytes_read_u8(table.states as *const u8, table.capacity as c_size, index as c_size,( &mut state)as *mut u8);
  }
  return state;
}
function keyIndexKey(table: &KeyIndex, index: usize): u64 {
  let key = 0u64;
  unsafe {
    tn_bytes_copy_at(table.keys as *const u8, table.capacity * 8usize as c_size, index * 8usize as c_size, 8 as c_size,( &mut key)as *mut u8);
  }
  return key;
}
function keyIndexValue(table: &KeyIndex, index: usize): usize {
  let value = 0usize;
  unsafe {
    tn_bytes_copy_at(table.values as *const u8, table.capacity * 8usize as c_size, index * 8usize as c_size, 8 as c_size,( &mut value)as *mut u8);
  }
  return value;
}
function keyIndexSlot(table: &KeyIndex, key: u64): usize {
  if (table.capacity === 0usize) {
    return table.capacity;
  }
  let index = keyIndexHash(key) & table.mask;
  let probes = 0usize;
  while (probes<table.capacity) {
    const state = keyIndexState(table, index);
    if (state === 0u8 || keyIndexKey(table, index) === key) {
      return index;
    }
    index =(index + 1usize) & table.mask;
    probes = probes + 1usize;
  }
  return table.capacity;
}
function keyIndexInsert(table: &mut KeyIndex, key: u64, value: usize): void {
  const index = keyIndexSlot(table, key);
  if (index === table.capacity) {
    return;
  }
  unsafe {
    const keyValue = key;
    const indexValue = value;
    tn_bytes_copy_to_at(( &keyValue)as *const u8, 8 as c_size, 0, 8 as c_size, table.keys,(table.capacity * 8usize)as c_size,(index * 8usize)as c_size);
    tn_bytes_copy_to_at(( &indexValue)as *const u8, 8 as c_size, 0, 8 as c_size, table.values,(table.capacity * 8usize)as c_size,(index * 8usize)as c_size);
