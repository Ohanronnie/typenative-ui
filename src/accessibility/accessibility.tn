import { Array } from "std/collections";
import { String } from "std/string";
import { AccessibilityRole } from "../tnx-runtime";

export class AccessibilityNode {
  public role: AccessibilityRole;
  public label: string;
  public enabled: bool;
  public selected: bool;
  public focused: bool;
  public value: string;
  public children: Array<AccessibilityNode>;
  public constructor(role: AccessibilityRole, label: string) {
    this.role = role;
    this.label = move label;
    this.enabled = true;
    this.selected = false;
    this.focused = false;
    this.value = String("");
    this.children = new Array<AccessibilityNode>({
      capacity: 0
    });
  }
  public add(child: AccessibilityNode): void {
    this.children.push(move child);
  }
  public childCount(): usize {
    return this.children.length;
  }
  public setEnabled(value: bool): void {
    this.enabled = value;
  }
  public setSelected(value: bool): void {
    this.selected = value;
  }
  public setFocused(value: bool): void {
    this.focused = value;
  }
  public setValue(value: string): void {
    this.value = move value;
  }
}
export class AccessibilityTree {
  public root: AccessibilityNode;
  public constructor(root: AccessibilityNode) {
    this.root = move root;
  }
}
export function accessibilityNode(role: AccessibilityRole, label: &str): AccessibilityNode {
  return new AccessibilityNode(role, String(label));
}
