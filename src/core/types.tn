import { Element, ElementRef } from "../jsx-runtime";
export enum FlexDirection {
  Row, Column,
}
export enum Align {
  Auto, Start, Center, End, Stretch,
}
export enum Justify {
  Start, Center, End, SpaceBetween, SpaceAround, SpaceEvenly,
}
export enum PositionType {
  Relative, Absolute,
