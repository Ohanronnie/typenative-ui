import { Text, styledView } from "../src/components";
import { EmptyProps, Style, styleSetHeight, styleSetPadding, styleSetWidth } from "../src/core/types";
import { HeadlessRenderer } from "../src/renderer/headless";
import { Element, hostChildAt } from "../src/tnx-runtime";

function Root(props: EmptyProps): Element {
  const style = new Style();
  styleSetWidth( &mut style, 120.0f32);
  styleSetHeight( &mut style, 80.0f32);
  styleSetPadding( &mut style, 4.0f32);
  const child = Text({
    children: "ok",
  });
  return styledView( &style, move child);
}
function main(): i32 {
  using renderer = new HeadlessRenderer();
  renderer.mount(<Root />);
  const root = renderer.rootElement();
  const content = hostChildAt(root, 0usize);
  if (!root.hasStyle() || root.style().width !== 120.0f32 || root.style().height !== 80.0f32 || root.style().padding !== 4.0f32) {
    renderer.unmount();
    return 10;
  }
  if (content === undefined || content!.textLength() !== 2usize) {
    renderer.unmount();
    return 11;
  }
  renderer.unmount();
  return 0;
}
